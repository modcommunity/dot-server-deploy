# Godot
.godot/

# Every dot-* addon is a separate repository. setup.sh links or copies them in.
/addons/

# The games, copied in by setup.sh from ../game-simple-lobby, ../game-hungario and
# ../game-g2gfast. They are compiled into this build on purpose; content/lobby/game.yml
# says why. maps/ and avatars/ are g2gfast's, and are top-level for the reason setup.sh
# gives: a .tscn names its scripts by absolute res:// path and there is no relative form.
/game/
/scenes/
/maps/
/avatars/

# Written per deployment by demo.sh before the export, naming the backbone the web
# player signs in against. Not tracked, because it is a deployment's answer and not
# this repository's.
/client/auth.json

# Generated by setup.sh
/server

# Everything the server writes: admins, bans, the audit log, the config the YAML
# compiled into.
/data/

# Exports
/web/build/
/build/
export_presets.cfg
# The zip web/README.md tells an operator to make out of web/build/ for the
# site's Web game build field. A 12 MB artifact of a build, not a source of one.
/build.zip

# OS
.DS_Store
Thumbs.db

# Node modules for the browser check (playwright is borrowed from website-city)
node_modules/
