# Godot
.godot/

# Every dot-* addon is a separate repository. setup.sh links or copies them in.
/addons/

# The games, copied in by setup.sh from the five game repositories beside this one.
# They are compiled into this build on purpose; content/lobby/game.yml says why.
#
# Everything below game/ and scenes/ is a top-level directory some game owns, and it is
# top-level for the reason setup.sh gives: a .tscn names its scripts by absolute res://
# path and there is no relative form, so a game's maps/ has to become THIS project's
# maps/. The list here has to match setup.sh's GAMES entries — a directory vendored and
# not ignored is a build's generated output committed as source.
/game/
/scenes/
/maps/
/avatars/
/npcs/
/props/

# Written per deployment by demo.sh before the export, naming the backbone the web
# player signs in against. Not tracked, because it is a deployment's answer and not
# this repository's.
/client/auth.json

# Generated by setup.sh
/server

# Generated by setup.ps1, from tools/server.ps1.in and for the same reason: both bake
# the path of the runtime the setup script found, which is a property of one machine.
# server.cmd is generated too -- it is a shim that forwards to server.ps1.
/server.ps1
/server.cmd

# Everything the server writes: admins, bans, the audit log, the config the YAML
# compiled into.
/data/

# Exports
/web/build/
/build/
export_presets.cfg
# The zip web/README.md tells an operator to make out of web/build/ for the
# site's Web game build field. A 12 MB artifact of a build, not a source of one.
/build.zip

# OS
.DS_Store
Thumbs.db

# Node modules for the browser check (playwright is borrowed from website-city)
node_modules/
/addons/dot_player_controller
/addons/dot_player
/.play/
