# Godot
.godot/

# Every dot-* addon is a separate repository. setup.sh links or copies them in.
/addons/

# The games were VENDORED here once — copied into one game/ and one scenes/ at this
# project's root, because a .tscn names its scripts by absolute res:// path. They are
# published as signed packs now and this build ships none of them, so none of these
# directories is created any more. The entries stay so that a checkout that predates the
# change, or a developer who copies a game in to debug it, does not offer a build's
# generated output as a change.
#
# textures/ was tracked rather than ignored, which made it the odd one out: it is
# g2gfast's prototype texture set, byte-identical to the copy in that repository, and
# `G2GTextures` reads it through the game's own rebase helper — so the pack carries it
# and a second copy here is a copy that can drift.
/game/
/scenes/
/maps/
/avatars/
/npcs/
/props/
/textures/

# Written per deployment by demo.sh before the export, naming the backbone the web
# player signs in against. Not tracked, because it is a deployment's answer and not
# this repository's.
/client/auth.json

# Every game is a separate repository too. setup.sh clones a missing one in here, or
# links a sibling checkout in, and publishes each as a signed pack into dist/. Nothing
# in here is built or shipped -- a .gdignore beside them keeps Godot out, because a game
# walked as part of this project declares its class_name globals a second time and a
# DELIVERED game's scripts then resolve those names to this build's copy.
/games/

# Generated by setup.sh
/server

# Generated by setup.ps1, from tools/server.ps1.in and for the same reason: both bake
# the path of the runtime the setup script found, which is a property of one machine.
# server.cmd is generated too -- it is a shim that forwards to server.ps1.
/server.ps1
/server.cmd

# Everything the server writes: admins, bans, the audit log, the config the YAML
# compiled into.
/data/

# The configuration of THIS deployment. Written on first run by setup.sh from
# cfg.example/, which is the tracked copy and the only one.
#
# It was tracked once and that was the mistake: a file an operator edits in place, in
# git, means `git pull` on a running server stops with "your local changes to
# cfg/server.yml would be overwritten by merge" -- and the change it is refusing to
# merge is a default nobody wanted, over an answer somebody chose. It also put a
# generated RCON password in a public repository, because setup.sh wrote one where
# git was watching, and a port and a uid belonging to one box became everybody's
# defaults.
#
# cfg/content.json is generated from client/content.json and is covered by this too.
/cfg/

# Exports
/web/build/
/build/
export_presets.cfg
# The archive for the site's Web game build field, written by
# `./server export-web --zip`. Tens of megabytes of build output, not a source of
# one. /build.zip is where the README used to say to make it by hand, and stays
# ignored so an older checkout does not start offering it as a change.
/web/build.zip
/build.zip

# OS
.DS_Store
Thumbs.db

# Node modules for the browser check (playwright is borrowed from website-city)
node_modules/
/.play/

# Filled in from deploy/env.example. Never committed.
/.env

# Content signing keys. THE PRIVATE ONE IS A SECRET and is what proves a pack came
# from us -- a client mounts scripts out of a pack, so anybody holding it can run
# code on every player who joins a server that serves their content. Ignored BEFORE
# it is generated, so it cannot arrive in a commit by being written first.
# The PUBLIC half belongs in client/content.json, which is shipped on purpose.
/keys/

# Published content packs -- manifest.json + content-addressed objects/, written by
# `dot_cloud_cli publish`. Build output of a build: megabytes per map, regenerable
# from maps/ and the signing key, and belonging on a CDN rather than in history.
/dist/

# Rendered by tools/progress_shot.gd. Regenerable, and a picture is not a source.
/screenshots/
