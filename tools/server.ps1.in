#
# GENERATED by setup.ps1. Re-run setup.ps1 to regenerate it.
#
# A front door for a dot-server on Windows, and the twin of ./server on everything
# else. Everything it does before starting one is the point: find the runtime, resolve
# the directories, refuse a configuration that would start a server nobody can
# administer safely, and print an address a friend can paste.
#
#   .\server.ps1                 start it
#   .\server.ps1 -h              every option
#
# WHY THIS EXISTS AND server.cmd IS NOW A SHIM
#
# setup.ps1 used to write a nine-line batch file: `check`, `config`, `games`, and
# everything else handed to Godot unread. The Bash launcher beside it takes --port,
# --bind, --name, --max-players, --game, --config, --content, --data, --godot,
# --dry-run and a `--` passthrough, refuses a runtime older than 4.4, refuses a secret
# on the command line, and exits with a code a supervisor can read. None of that was
# reachable from Windows -- so the documented way to run a server was documented for
# one of the two platforms this project claims to support, and the other one got a
# wrapper that could not even tell you why it failed.
#
# OPTION SPELLING: BOTH, DELIBERATELY
#
# `--port 6070` and `-Port 6070` both work. PowerShell people expect the second; every
# line of documentation, every README and every copied command in this project is
# written in the first, because it is what the server itself and the Bash launcher
# take. A launcher that accepts only the native spelling makes every example wrong on
# Windows, and one that accepts only the foreign spelling is a PowerShell script that
# does not behave like one. Accepting both costs one `TrimStart`.
#
# Exit codes are meaningful so a supervisor can tell a misconfiguration from a crash:
#   2 usage   3 no runtime   4 no project   5 bad config   6 port in use   7 bad content

$ErrorActionPreference = 'Stop'

# Where this script lives. $PSScriptRoot is tools\ only if it is run from there; it is
# written to the project root, so this is the project.
$Project = $PSScriptRoot
if (-not $Project) { $Project = (Get-Location).Path }

# The runtime setup.ps1 found. Re-resolved when it has since moved, because a baked
# path that silently stops working is worse than a search that takes a millisecond.
$Godot = '@GODOT@'

# Where the exported engine will be served from. Baked into the loader by export-web;
# see web/tmc-loader.js for why it cannot be discovered at runtime.
$EngineBase = ''

$ConfigDir  = 'cfg'
$ContentDir = 'content'
$DataDir    = 'data'
$Command    = 'run'
$Verbose    = $false
$DryRun     = $false
$PackId     = ''

# export-native: which machines to build for, and what the publisher calls the build.
$NativePlatform = if ($env:TMC_NATIVE_PLATFORM) { $env:TMC_NATIVE_PLATFORM } else { 'all' }
$BuildVersion   = if ($env:TMC_BUILD_VERSION)   { $env:TMC_BUILD_VERSION }   else { '' }
$Overrides  = @()
$Passthrough = @()

function Die([string]$Message, [int]$Code = 2) {
    Write-Host ''
    Write-Host "  $Message" -ForegroundColor Red
    Write-Host ''
    exit $Code
}

function Note([string]$Message) { Write-Host "  $Message" -ForegroundColor DarkGray }

function Show-Usage {
@'
  .\server.ps1 [command] [options] [-- +consolecommand ...]

  Commands
    run                 Start the server. The default.
    check               Boot, load the game, shut down. Exit 0 if it all worked.
    config              Print the resolved configuration and exit.
    games               List what is in the content directory and exit.
    pack <id>           Publish content\<id> as a signed dot-cloud pack.
    export-web          Build the browser client into web\build, plus the
                        loader website-city uploads. Takes --base.
    export-native       Build the native client the desktop app installs, into
                        build\, one archive per platform. Takes --platform and
                        --build-version, and prints the publish command for each.
    stamp-loader        Rewrite web\build\tmc-loader.js with a new --base and
                        nothing else. Moving the engine to another domain is a
                        deployment change, not a rebuild.

  Options                                    (-Port and --port both work)
    --port N            Listen here instead of what cfg\net.yml says.
    --bind ADDR         Interface to bind. * or 0.0.0.0 is every one.
    --name TEXT         Server name shown in listings.
    --max-players N
    --game ID           Load this game at boot instead of the default.
    --map ID            Start that game on this map instead of its own default.
                        `+map ID` after a -- does the same thing and is the
                        spelling every other dedicated server uses. A game that
                        has no maps, or has not got this one, says so and boots
                        on its default anyway.

    --config DIR        Where the YAML lives.            (cfg)
    --content DIR       Where the games live.            (content)
    --data DIR          Where the server writes.         (data)

    --base URL          Where the exported engine will be served from. Baked into
                        web\build\tmc-loader.js, which the site uploads as the
                        app's web game loader. export-web and stamp-loader.

                        It MUST be an origin of its own, not a path on the site.
                        The loader frames the engine with a sandbox that is only
                        a boundary while the frame is cross-origin, and refuses
                        to start if this resolves to the page's own origin.

    --platform TARGET   export-native only. linux, windows, macos, or all.

    --build-version V   export-native only. What the publisher calls this build.
                        Dotted numeric, because the desktop app COMPARES it to
                        decide whether an install is out of date. Defaults to
                        1.<yyyymmdd>.<hhmm> in UTC.

    --godot PATH        Use this runtime.
    --verbose           Debug logging.
    --dry-run           Print the command that would run, and exit.
    -h, --help

  Anything after -- is handed to the server console once it is up:

    .\server.ps1 -- +sv_cheats 1 +changelevel lobby

  With one exception, and it is the one worth knowing: `+map ID` is read by the
  HOST, not by the console. The console's +command half runs when the listener
  opens, which is before any game is loaded, so the `map` command it would be
  looking for belongs to a module that does not exist yet.

    .\server.ps1 --game g2gfast -- +map bhop_g2g_intro

  Secrets are deliberately NOT options. argv is readable by every other process on
  the machine and ends up in pasted bug reports, which is why DotConfig refuses
  secrets from argv and the environment too. rcon_password lives in cfg\rcon.yml.
'@ | Write-Host
}

# [b]An imported map must NOT be in the build, and MUST be on the CDN.[/b]
#
# This check used to assert the OPPOSITE here, long after the bash launcher's had been
# turned around, and the divergence is the whole argument against a second
# implementation: `include_filter="maps/*.bin"` was the right fix when the build was
# meant to carry map geometry, and it made a 105 MB download in which 66 MB was eight
# maps so that a player could play one. The same eight are published as dot-cloud packs
# and fetched on join, so the presets exclude `maps/imported/*` -- and a Windows
# operator running the export got "8 map geometry file(s) did not reach the export" and
# a dead stop on a build that was correct.
#
# What has to be true now is the other pair, and the second one is the one worth having:
# a map excluded from the build and never published is a map nobody can reach, and the
# symptom is a player who connects, spawns, and sees sky in every direction.
function Test-ExcludedMaps([string]$Pack) {
    $mapsDir = Join-Path $Project 'maps\imported'
    if (-not (Test-Path -LiteralPath $Pack)) { return }
    if (-not (Test-Path -LiteralPath $mapsDir)) { return }

    # ISO-8859-1 keeps one byte to one char, so a search over this string is a search
    # over the bytes; UTF8 would fold invalid sequences and move every offset. By code
    # page rather than by `::Latin1`, which is a .NET Core static that Windows
    # PowerShell 5.1 -- the one shipped with Windows -- does not have.
    $blob = [System.Text.Encoding]::GetEncoding(28591).GetString([System.IO.File]::ReadAllBytes($Pack))
    $carried = 0
    $unpublished = 0

    foreach ($bin in (Get-ChildItem -Recurse -LiteralPath $mapsDir -Filter '*.bin')) {
        $rel = $bin.FullName.Substring($Project.Length).TrimStart('\', '/').Replace('\', '/')
        $id = Split-Path -Leaf (Split-Path -Parent $bin.FullName)

        if ($blob.IndexOf($rel) -ge 0) {
            Write-Host "  the export is carrying $rel, which the CDN already serves" -ForegroundColor Yellow
            $carried++
        }

        if (-not (Test-Path -LiteralPath (Join-Path $Project "dist\$id\manifest.json"))) {
            Write-Host "  $id is not in the build and is not published" -ForegroundColor Red
            $unpublished++
        }
    }

    if ($carried -gt 0) {
        Write-Host "  $carried map(s) are in the pack as well as on the CDN -- exclude_filter should hold maps/imported/*" -ForegroundColor Yellow
    }
    if ($unpublished -gt 0) {
        # Naming the directory is the point: `pack <id>` publishes content\<id>, and no
        # imported map has ever lived there.
        Die "$unpublished map(s) reach nobody: not in the build, not in dist\. Publish them with `".\server.ps1 pack --all --content maps\imported`" -- the map id is the content id and the directory is not content\ -- or drop maps/imported/* from exclude_filter." 3
    }
}

# The native client the desktop app installs: one archive per platform, and the command
# that publishes each. See tools/server.in for why the launch arguments need the bare
# `--` -- `client\shell.gd` reads the address from OS.get_cmdline_user_args(), which is
# only what follows one, and Godot 4 ignores an unrecognised argument rather than
# refusing to start, so the wrong spelling runs perfectly and connects to nothing.
function Invoke-ExportNative {
    $targets = switch -Regex ($NativePlatform) {
        '^(all)$'                     { @('linux', 'windows', 'macos'); break }
        '^(linux|linux-x64)$'         { @('linux');   break }
        '^(windows|win|windows-x64)$' { @('windows'); break }
        '^(macos|mac|osx)$'           { @('macos');   break }
        default { Die "--platform takes linux, windows, macos or all -- not $NativePlatform" }
    }

    $presetFile = Join-Path $Project 'export_presets.cfg'
    if (-not (Test-Path -LiteralPath $presetFile)) {
        Die "no export_presets.cfg -- the editor rewrites that file so it is not tracked. Copy export_presets.example.cfg over it, or run .\setup.ps1." 5
    }

    if (-not $BuildVersion) {
        # Built by pieces rather than as one format string: a custom .NET date format
        # gives `/` and `:` culture-dependent meanings, and a version that comes out
        # differently on a machine with another locale is the kind of thing nobody
        # tests for.
        $now = (Get-Date).ToUniversalTime()
        $BuildVersion = '1.' + $now.ToString('yyyyMMdd') + '.' + $now.ToString('HHmm')
    }

    # Godot caches its text->binary scene conversions here and --import does not
    # invalidate them; see export-web for the uid story.
    $cache = Join-Path $Project '.godot\exported'
    if (Test-Path -LiteralPath $cache) { Remove-Item -Recurse -Force $cache }

    $published = @()

    foreach ($target in $targets) {
        $spec = switch ($target) {
            'linux'   { @{ Preset = 'Linux x86_64';   Dir = 'build\linux-x64';   Binary = 'tmc.x86_64';
                           Entry = 'tmc.x86_64';      Archive = 'build\tmc-linux-x64.zip';   Api = 'LINUX_X64' } }
            'windows' { @{ Preset = 'Windows x86_64'; Dir = 'build\windows-x64'; Binary = 'tmc.exe';
                           Entry = 'tmc.exe';         Archive = 'build\tmc-windows-x64.zip'; Api = 'WINDOWS_X64' } }
            'macos'   { @{ Preset = 'macOS';          Dir = 'build\macos';       Binary = 'tmc.zip';
                           Entry = 'TMC.app/Contents/MacOS/TMC'; Archive = 'build\tmc-macos.zip'; Api = 'MACOS_UNIVERSAL' } }
        }

        if ((Get-Content -LiteralPath $presetFile -Raw).IndexOf("name=`"$($spec.Preset)`"") -lt 0) {
            Die "export_presets.cfg has no preset named `"$($spec.Preset)`". export_presets.example.cfg is the tracked copy that does." 5
        }

        $outDir = Join-Path $Project $spec.Dir
        New-Item -ItemType Directory -Path $outDir -Force | Out-Null
        $binary = Join-Path $outDir $spec.Binary
        if (Test-Path -LiteralPath $binary) { Remove-Item -Force $binary }

        Write-Host ""
        Write-Host "  exporting $($spec.Preset)" -ForegroundColor White

        & $Godot --headless --path $Project --export-release $spec.Preset $binary
        if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }

        # Checked rather than trusted: an export can print an error and leave the exit
        # code alone, which makes the artifact existing the only evidence worth acting
        # on. `.\server.ps1 pack` naming a scene that was never written and exiting 0 is
        # the reason this project does not believe an exit code on its own.
        if (-not (Test-Path -LiteralPath $binary)) {
            Die "the $($spec.Preset) export produced no $($spec.Dir)\$($spec.Binary) -- export templates missing? .\setup.ps1 installs them" 3
        }

        Test-ExcludedMaps $binary

        $archive = Join-Path $Project $spec.Archive
        if (Test-Path -LiteralPath $archive) { Remove-Item -Force $archive }

        if ($target -eq 'macos') {
            # Godot already wrote a zip holding the .app, with the bundle's mode bits in
            # it. Repacking it here would drop them, because Compress-Archive has no
            # concept of a unix mode.
            Copy-Item -LiteralPath $binary -Destination $archive
        } else {
            # Zipped from INSIDE the directory, so the entry is `tmc.exe` and not
            # `windows-x64\tmc.exe`: --entry is a path inside the archive, and a leading
            # directory nobody declared is an install that lands and cannot be started.
            #
            # A Linux build zipped on Windows loses its +x, which is survivable exactly
            # because the desktop app re-marks the entry executable after unpacking --
            # it has to, since a Godot export can arrive without it however it travelled.
            Compress-Archive -Path (Join-Path $outDir '*') -DestinationPath $archive
        }

        $size = [math]::Round((Get-Item -LiteralPath $archive).Length / 1MB)
        Write-Host "  wrote $($spec.Archive) (${size} MB)"
        $published += ,@($spec.Api, $archive, $spec.Entry)
    }

    Write-Host ""
    Write-Host "  publish them from website-city:" -ForegroundColor White
    Write-Host ""

    foreach ($row in $published) {
        Write-Host "    npm run app:build:publish -- ``"
        Write-Host "        --app godot --platform $($row[0]) --version $BuildVersion ``"
        Write-Host "        --file $($row[1]) ``"
        Write-Host "        --entry `"$($row[2])`" ``"
        Write-Host "        --args `"--,--connect,{host}:{port}`""
        Write-Host ""
    }

    # `--app godot` is the ENGINE app: a server hangs off it rather than off a game,
    # because it can change which game it is running while players stay connected, so a
    # Play press resolves the build from there. Same rule as the web build.
    exit 0
}

# --- Arguments -------------------------------------------------------------

$rest = @($args)

# [b]`$a[1..($a.Count - 1)]` is not "the tail".[/b] When Count is 1 that is `1..0`,
# which PowerShell evaluates as a DESCENDING range -- so it returns elements 1 and 0,
# and the argument just consumed comes back at the front. `.\server.ps1 check` would
# have parsed `check` as an option and refused to run. One helper, used everywhere a
# tail is taken.
function Get-Tail($Items, [int]$From) {
    if ($From -ge $Items.Count) { return @() }
    return @($Items[$From..($Items.Count - 1)])
}

if ($rest.Count -gt 0) {
    switch -Regex ($rest[0]) {
        '^(run|check|config|games|export-web|export-native|stamp-loader)$' {
            $Command = $rest[0]; $rest = Get-Tail $rest 1
        }
        '^pack$' {
            $Command = 'pack'
            if ($rest.Count -lt 2) { Die 'pack needs a game id: .\server.ps1 pack lobby' }
            $PackId = $rest[1]
            $rest = Get-Tail $rest 2
        }
    }
}

# One spelling internally. `--port`, `-Port` and `/port` all arrive as `port`, so the
# chain below has one arm per option rather than three.
function Get-OptionName([string]$Token) {
    if ($Token -match '^(--|-|/)(\?|[A-Za-z][-A-Za-z]*)$') { return $Matches[2].ToLower() }
    return $null
}

# [b]if/elseif and not `switch`, on purpose.[/b] `continue` inside a PowerShell `switch`
# continues the SWITCH -- it moves to the next item of the switch's own input -- and does
# not touch the `while` around it. Written as a switch, this loop reads like every other
# argument parser in this project and advances $i by the wrong amount on half its paths.
$i = 0
while ($i -lt $rest.Count) {
    $token = [string]$rest[$i]

    if ($token -eq '--') {
        $Passthrough = Get-Tail $rest ($i + 1)
        break
    }

    $name = Get-OptionName $token
    $hasValue = ($i + 1) -lt $rest.Count
    $value = if ($hasValue) { [string]$rest[$i + 1] } else { $null }

    if ($name -in @('h', 'help', '?')) { Show-Usage; exit 0 }

    if ($name -in @('rcon-password', 'password')) {
        Die "secrets are not accepted on a command line; put it in $ConfigDir\server.yml"
    }

    if ($name -in @('verbose')) { $Verbose = $true; $i += 1; continue }
    if ($name -in @('dry-run', 'dryrun')) { $DryRun = $true; $i += 1; continue }

    if ($name -in @('port', 'bind', 'name', 'max-players', 'maxplayers', 'game',
                    'map', 'base', 'config', 'content', 'data', 'godot',
                    'platform', 'build-version')) {
        if (-not $hasValue) { Die "$token needs a value" }
        switch ($name) {
            'base'          { $EngineBase = $value }
            'platform'      { $NativePlatform = $value }
            'build-version' { $BuildVersion = $value }
            'config'  { $ConfigDir  = $value }
            'content' { $ContentDir = $value }
            'data'    { $DataDir    = $value }
            'godot'   { $Godot      = $value }
            default   {
                # Passed on under the server's own spelling, which is the hyphenated
                # one, whatever the caller typed.
                $flag = if ($name -eq 'maxplayers') { 'max-players' } else { $name }
                $Overrides += @("--$flag", $value)
            }
        }
        $i += 2
        continue
    }

    Die "unknown option: $token  (.\server.ps1 --help)"
}

# --- The runtime -----------------------------------------------------------

if (-not (Test-Path -LiteralPath $Godot -PathType Leaf)) {
    # The cache setup.ps1 downloads into is searched too. The baked path above is
    # normally that same file; this is what makes .\server.ps1 survive the cache
    # moving, or being written on one machine and run on another that ran setup for
    # itself.
    $cacheRoot = if ($env:TMC_GODOT_CACHE) { $env:TMC_GODOT_CACHE } else { Join-Path $env:LOCALAPPDATA 'tmc\godot' }

    $found = $null
    if (Test-Path -LiteralPath $cacheRoot -PathType Container) {
        $cached = Get-ChildItem -Path $cacheRoot -Filter '*_console.exe' -Recurse -ErrorAction SilentlyContinue |
                  Sort-Object Name -Descending | Select-Object -First 1
        if ($cached) { $found = $cached.FullName }
    }

    if (-not $found) {
        foreach ($candidate in @($Godot, 'godot', 'godot4', 'Godot')) {
            if (-not $candidate) { continue }
            $cmd = Get-Command $candidate -ErrorAction SilentlyContinue
            if ($cmd) { $found = $cmd.Source; break }
        }
    }
    if (-not $found) {
        Die 'no Godot runtime found. Run .\setup.ps1, or .\server.ps1 --godot C:\path\to\godot.exe' 3
    }
    $Godot = $found
}

if (-not (Test-Path -LiteralPath (Join-Path $Project 'project.godot'))) {
    Die "no Godot project at $Project" 4
}

$version = (& $Godot --version 2>$null | Select-Object -First 1)
if (-not $version) { Die "could not run $Godot --version" 3 }
# 4.4 or newer. Compared as numbers and not as text, because "4.10" sorts before "4.4"
# in every string comparison and this project is already past 4.7.
if ($version -match '^(\d+)\.(\d+)') {
    $major = [int]$Matches[1]; $minor = [int]$Matches[2]
    if ($major -lt 4 -or ($major -eq 4 -and $minor -lt 4)) {
        Die "Godot 4.4 or newer is required; $Godot is $version" 3
    }
} else {
    Die "could not read a version out of '$version'" 3
}

# --- Directories -----------------------------------------------------------

function Resolve-Dir([string]$Path) {
    if ([System.IO.Path]::IsPathRooted($Path)) { return $Path }
    return (Join-Path $Project $Path)
}

$configPath  = Resolve-Dir $ConfigDir
$contentPath = Resolve-Dir $ContentDir
$dataPath    = Resolve-Dir $DataDir

if (-not (Test-Path -LiteralPath $configPath -PathType Container)) {
    Die "no config directory at $configPath  (run .\setup.ps1)" 5
}
if (-not (Test-Path -LiteralPath $contentPath -PathType Container)) {
    Die "no content directory at $contentPath" 7
}
if (-not (Test-Path -LiteralPath $dataPath -PathType Container)) {
    try { New-Item -ItemType Directory -Path $dataPath -Force | Out-Null }
    catch { Die "could not create $dataPath" 5 }
}

# --- Is something already on the port? -------------------------------------
#
# [b]Exit code 6 has been documented since the Bash launcher was written and was
# never once returned by it.[/b] A dot-server that cannot bind exits with Godot's own
# code and a line in the middle of its boot log, so a supervisor restarts it forever
# against a port somebody else owns. The check belongs in the launcher, before any of
# that, and it belongs in both launchers.
#
# A one-key read of the YAML, not a parser: rcon.mjs makes the same choice for the same
# reason -- a second parser here would drift from the one the server actually uses.
function Read-Cfg([string]$File, [string]$Key) {
    if (-not (Test-Path -LiteralPath $File)) { return '' }
    foreach ($line in (Get-Content -LiteralPath $File)) {
        if ($line -match "^\s*$Key\s*:\s*`"?([^`"#]*)`"?") { return $Matches[1].Trim() }
    }
    return ''
}

function Test-PortBusy([int]$Port) {
    # Get-NetTCPConnection is Windows-only and absent on PowerShell for Linux, where this
    # script can legitimately be run -- and on Windows it raises a terminating error when
    # NOTHING is listening rather than returning nothing. Both land in the catch and both
    # answer "not busy", which is the right answer for each: an unavailable check is not a
    # failed check, and a free port is a free port.
    try {
        $listening = Get-NetTCPConnection -State Listen -LocalPort $Port -ErrorAction Stop
        return ($null -ne $listening)
    } catch { return $false }
}

if ($Command -eq 'run') {
    $port = 0
    for ($k = 0; $k -lt $Overrides.Count - 1; $k++) {
        if ($Overrides[$k] -eq '--port') { $port = [int]$Overrides[$k + 1] }
    }
    if (-not $port) {
        # [b]`[int]''` THROWS in PowerShell[/b], and $ErrorActionPreference is Stop, so
        # casting a missing key straight to an int would end the script with a type
        # conversion error where a server with no `net_port` line should simply start on
        # its default. Matched as digits first, cast second.
        $declared = Read-Cfg (Join-Path $configPath 'net.yml') 'net_port'
        if ($declared -match '^\d+$') { $port = [int]$declared }
    }
    if ($port -and (Test-PortBusy $port)) {
        Die "port $port is already in use. Stop what is on it, or .\server.ps1 --port N" 6
    }
    # And the RCON listener, which is the game port plus one and is the half nobody
    # thinks of: two servers a single port apart collide here and nowhere else, and the
    # message the loser prints names a port that looks free.
    if ($port -and (Test-PortBusy ($port + 1))) {
        Die "port $($port + 1) is in use, and that is where RCON listens (the game port plus one)" 6
    }
}

# --- The loader ------------------------------------------------------------

function Write-Loader {
    $template = Join-Path $Project 'web\tmc-loader.js'
    if (-not (Test-Path -LiteralPath $template)) { return }

    if ($EngineBase) {
        # An origin, not a path. The loader refuses a same-origin base at runtime
        # anyway, but that failure lands in a player's browser console; this one lands
        # in the terminal of the person who typed it.
        if ($EngineBase -notmatch '^https?://') {
            Die "--base must be an absolute URL with a scheme: $EngineBase"
        }
        if (-not $EngineBase.EndsWith('/')) { $EngineBase = "$EngineBase/" }
    } else {
        Write-Host '  --base was not given; the loader will refuse to start' -ForegroundColor Yellow
    }

    $out = Join-Path $Project 'web\build'
    New-Item -ItemType Directory -Path $out -Force | Out-Null
    $text = [System.IO.File]::ReadAllText($template)
    [System.IO.File]::WriteAllText(
        (Join-Path $out 'tmc-loader.js'),
        $text.Replace('@ENGINE_BASE@', $EngineBase),
        (New-Object System.Text.UTF8Encoding $false))
    $shown = if ($EngineBase) { $EngineBase } else { '<unset>' }
    Write-Host "  tmc-loader.js  engine base: $shown"
}

# --- The command -----------------------------------------------------------

$scene = 'res://host/host.tscn'
$godotArgs = @('--headless', '--path', $Project, $scene, '--',
               '--config', $ConfigDir, '--content', $ContentDir, '--data', $DataDir)

switch ($Command) {
    'check'  { $godotArgs += '--selftest' }
    'config' { $godotArgs += '--print-config' }
    'games'  { $godotArgs += '--list-games' }
    'pack'   {
        $godotArgs = @('--headless', '--path', $Project, 'res://tools/publish.tscn', '--',
                       '--config', $ConfigDir, '--content', $ContentDir, '--data', $DataDir,
                       '--game', $PackId)
    }
    'export-web' {
        New-Item -ItemType Directory -Path (Join-Path $Project 'web\build') -Force | Out-Null

        # Godot caches its text->binary scene conversions in .godot\exported\, and
        # --import does NOT invalidate them. setup copies each game's .gd files out of
        # its sibling repository and Godot then mints a FRESH .uid for every one -- so a
        # re-vendored script gets a new uid while the cached conversion of the scene
        # that references it still carries the old one. The exported build then ships a
        # scene pointing at a uid that exists nowhere. It recovers, because these scenes
        # name a path as well as a uid, which is why it went unnoticed for so long: the
        # only trace is a red line in a browser console. Cheapest fix is not to reuse it.
        $cache = Join-Path $Project '.godot\exported'
        if (Test-Path -LiteralPath $cache) { Remove-Item -Recurse -Force $cache }

        & $Godot --headless --path $Project --export-release 'Web' `
            (Join-Path $Project 'web\build\index.html')
        if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }

        # The two things that have to be true about a map the preset excluded. Shared
        # with export-native, which excludes the same directory for the same reason.
        Test-ExcludedMaps (Join-Path $Project 'web\build\index.pck')

        $embed = Join-Path $Project 'web\embed.html'
        if (Test-Path -LiteralPath $embed) {
            Copy-Item -LiteralPath $embed -Destination (Join-Path $Project 'web\build\embed.html') -Force
        }

        Write-Loader
        Write-Host "  wrote $(Join-Path $Project 'web\build')"
        exit 0
    }
    'export-native' { Invoke-ExportNative }
    'stamp-loader' {
        if (-not $EngineBase) { Die 'stamp-loader needs --base https://games.example.net/' }
        Write-Loader
        exit 0
    }
}

if ($Verbose)               { $godotArgs += '--verbose' }
if ($Overrides.Count)       { $godotArgs += $Overrides }
if ($Passthrough.Count)     { $godotArgs += $Passthrough }

if ($DryRun) {
    $quoted = @($Godot) + $godotArgs | ForEach-Object {
        if ($_ -match '[\s"]') { '"' + ($_ -replace '"', '\"') + '"' } else { $_ }
    }
    Write-Host ($quoted -join ' ')
    exit 0
}

# Called directly and not through Start-Process: one console, one process tree, so
# Ctrl-C reaches the server rather than a wrapper that would have to forward it.
& $Godot @godotArgs
exit $LASTEXITCODE
