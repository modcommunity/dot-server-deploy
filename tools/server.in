#!/usr/bin/env bash
#
# GENERATED by setup.sh. Re-run setup.sh to regenerate it.
#
# A front door for a dot-server. Everything it does before starting one is the point:
# find the runtime, resolve the directories, refuse a configuration that would start a
# server nobody can administer safely, and print an address a friend can paste.
#
#   ./server                     start it
#   ./server --help              every option
#
# Exit codes are meaningful so a supervisor can tell a misconfiguration from a crash:
#   2 usage   3 no runtime   4 no project   5 bad config   6 port in use   7 bad content

set -uo pipefail

# Where this script lives, resolved through symlinks, so ./server works from anywhere.
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
    DIR="$(cd -P "$(dirname "$SELF")" && pwd)"
    SELF="$(readlink "$SELF")"
    [[ $SELF != /* ]] && SELF="$DIR/$SELF"
done
PROJECT="$(cd -P "$(dirname "$SELF")" && pwd)"
# Kept for TMC_AUTO_UPDATE, which re-runs this script with exactly what it was given once
# the addons have been moved.
ORIG_ARGS=("$@")

# [b]Every option here is also an environment variable, because this runs on a box
# nobody is typing at.[/b] A deployment is a machine with a unit file or a container on
# it, and a setting that can only arrive as an argument has to be baked into whatever
# invokes the script -- which puts the configuration of the server in a file that is not
# the server's, in a format that is not this one's, on every host separately.
#
# The layering is the family's, and the direction matters: **baked default, then
# environment, then command line.** An argument always wins, so a person debugging on
# the box can override the unit file for one run without editing it.
#
# TMC_RCON_PASSWORD IS DELIBERATELY NOT ONE OF THESE, and neither is any other secret.
# See the note at the end of --help: `DotConfig` refuses secrets from the environment as
# well as from argv, because both are readable by other processes on the machine --
# `/proc/<pid>/environ` for one and `ps` for the other -- and both end up in pasted bug
# reports. The password lives in cfg/rcon.yml, which is a file with a mode on it.

# The runtime setup.sh found. Re-resolved when it has since moved, because a baked path
# that silently stops working is worse than a search that takes a millisecond.
GODOT="${TMC_GODOT:-@GODOT@}"

# Libraries the egg bundled for a runtime image that lacks them (libfontconfig.so.1).
if [ -d "$PROJECT/.runtime/lib" ]; then
    export LD_LIBRARY_PATH="$PROJECT/.runtime/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi

# Where the exported engine will be served from. Baked into the loader by
# `export-web`; see web/tmc-loader.js for why it cannot be discovered at runtime.
ENGINE_BASE="${TMC_ENGINE_BASE:-}"

WANT_ZIP="${TMC_EXPORT_ZIP:+1}"

# Which machines `export-native` builds for, and what the publisher calls the build.
# Both are read here rather than beside the command, because everything in this block
# is a default an ARGUMENT overrides -- and a default assigned after the parser has run
# is a flag that silently does nothing.
NATIVE_PLATFORM="${TMC_NATIVE_PLATFORM:-all}"

# What the publisher calls this build. Dotted numeric because the app COMPARES it to
# decide an update, and date-stamped because the alternative is somebody remembering to
# bump a constant -- a build that ships with the version of the one before it is an
# update nobody is offered. `1.20260912.1819` compares the way it reads.
BUILD_VERSION="${TMC_BUILD_VERSION:-}"
CONFIG_DIR="${TMC_CONFIG_DIR:-cfg}"
CONTENT_DIR="${TMC_CONTENT_DIR:-content}"
DATA_DIR="${TMC_DATA_DIR:-data}"
COMMAND="run"
VERBOSE=""
[ -n "${TMC_VERBOSE:-}" ] && VERBOSE="--verbose"
PASSTHROUGH=()
OVERRIDES=()

# The five settings that are passed through to the server rather than used here. Held in
# variables rather than appended to OVERRIDES as they are seen, so that an argument
# REPLACES the environment instead of being appended after it -- two `--port` flags on
# one command line is not a thing to make the other side arbitrate.
OPT_PORT="${TMC_PORT:-}"
OPT_BIND="${TMC_BIND:-}"
# The other three ports. All derivable, and all derived WRONG on a panel: RCON defaults
# to the game port plus one and both query ports default to the game port itself, which
# is right when you choose the numbers and is not how an allocation-based host works.
OPT_RCON_PORT="${TMC_RCON_PORT:-}"
OPT_QUERY_PORT="${TMC_QUERY_PORT:-}"
OPT_A2S_PORT="${TMC_A2S_PORT:-}"
OPT_QUERY_BIND="${TMC_QUERY_BIND:-}"
OPT_NAME="${TMC_NAME:-}"
OPT_MAX_PLAYERS="${TMC_MAX_PLAYERS:-}"
OPT_GAME="${TMC_GAME:-}"
OPT_MAP="${TMC_MAP:-}"
OPT_WEB_LOADER="${TMC_WEB_LOADER:-}"
AUTO_UPDATE="${TMC_AUTO_UPDATE:-when-needed}"

# --- What this box installs, and where from ---------------------------------
#
# [b]A server no longer carries every game it could run.[/b] A game is a signed pack on
# the content origin plus a `game.yml` that says how to start it, and until `install-games`
# existed the descriptor half arrived only by cloning this repository -- so every
# deployment got all ten whether it ran one of them or ten, and adding an eleventh meant
# re-cloning every box. TMC_GAMES names the two or three this one is for; they are fetched
# from the origin at startup, packs and all.
#
# Empty is the hand-run case and changes nothing: no list means "offer whatever is in the
# content directory", which is how this worked before and how a development tree works.
OPT_GAMES="${TMC_GAMES:-}"

# Where the games come from. Empty means the installer reads `content_urls` out of
# cfg/server.yml, which is where the address already lives -- a default repeated here
# would be a second copy of one fact, and the copy nobody edits is the one that wins on
# the day somebody repoints a deployment at a mirror.
OPT_CONTENT_URL="${TMC_CONTENT_URL:-}"

# What happens to a game that is installed and is no longer in the list.
#
#   hide    (default) left on the disk, not offered. A restart with the id put back
#           costs nothing, and nothing an operator wrote is ever deleted.
#   remove  deleted -- but only games this tool installed itself, which it records in
#           data/installed-games.json. A game somebody authored under content/ by hand is
#           not ours to remove, and the day those two get confused is the day somebody
#           loses work.
#   keep    left on the disk AND still offered, which is the pre-install-games behaviour:
#           the list only adds. For a box whose content directory is managed by somebody
#           other than the panel.
GAMES_MODE="${TMC_GAMES_MODE:-hide}"

# Start without checking the origin. For a box that is deliberately offline, and for
# getting a server back up when the origin is the thing that is broken.
NO_INSTALL="${TMC_NO_INSTALL:+1}"
REFRESH=""

RED=$'\033[31m'; YLW=$'\033[33m'; DIM=$'\033[2m'; BLD=$'\033[1m'; OFF=$'\033[0m'

die() { printf '\n  %s%s%s\n\n' "$RED" "$1" "$OFF" >&2; exit "${2:-2}"; }
note() { printf '  %s%s%s\n' "$DIM" "$1" "$OFF"; }

# [b]This was called twice and defined nowhere.[/b] `export-web`'s two map checks both
# end in `|| warn "..."`, and with no such function bash printed `warn: command not
# found` and carried on -- so the one message telling an operator their build carries
# 66 MB it did not need to was replaced by a line that reads like the script is broken.
# The condition it guards is rare, which is why nobody hit it, and rare is exactly what
# a warning is for.
warn() { printf '  %s%s%s\n' "$YLW" "$1" "$OFF" >&2; }

usage() {
    cat <<'USAGE'
  ./server [command] [options] [-- +consolecommand ...]

  Commands
    run                 Start the server. The default.
    check               Boot, load the game, shut down. Exit 0 if it all worked.
    config              Print the resolved configuration and exit.
    games               List what is in the content directory and exit.
    pack <id> [--source DIR]
                        Publish content/<id> as a signed dot-cloud pack, into
                        dist/<id>. Any content directory, not only a game:
                        an avatar set, a prop pack or a texture set is
                        published exactly the same way. --all does every one.
    verify <id>         Check dist/<id>'s manifest against keys/content.pub.
    index               Write dist/games.json and dist/descriptors/, the half of
                        a publish a server INSTALLS from. Run it after
                        `pack --all`; a stale index points servers at versions
                        the origin no longer has.
    install-games       Fetch the descriptors and packs for --games from the
                        content origin, into content/ and data/content_cache.
                        `run` does this for you when TMC_GAMES is set.
    export-web          Build the browser client into web/build, plus the
                        loader website-city uploads. Takes --base and --zip.
    export-native       Build the native client the desktop app installs, into
                        build/, one archive per platform. Takes --platform and
                        --build-version, and prints the publish command for
                        each.
    stamp-loader        Rewrite web/build/tmc-loader.js with a new --base and
                        nothing else. Moving the engine to another domain is a
                        deployment change, not a rebuild.

  Options
    --port N            Listen here instead of what cfg/net.yml says.
    --bind ADDR         Interface to bind. * or 0.0.0.0 is every one.
    --rcon-port N       RCON listens here. Default is the game port plus one.
    --a2s-port N        A2S answers here (UDP). Default is the game port, whose
                        UDP side it shares with the desktop clients' ENet,
                        told apart by their first bytes.
    --query-port N      DQP answers here (UDP). Default is --a2s-port, so the
                        two share one socket and are told apart by their first
                        four bytes. Give both to split them.
    --query-bind ADDR   Interface the query listeners bind. `*` is every one.
                        The setting a reverse-proxied server cannot do without:
                        nginx forwards the game's WebSocket and cannot forward
                        UDP, so with --bind on loopback a tracker cannot reach
                        the query port and cannot tell that from a dead server.
    --name TEXT         Server name shown in listings.
    --max-players N
    --game ID           Load this game at boot instead of the default.
    --games A,B,C       The games this server installs and offers. Fetched from
                        the content origin at startup; anything else in
                        content/ is not offered. Empty offers everything, which
                        is what a hand-run server wants.
    --content-url URL   Where games come from, comma-separated for mirrors.
                        Replaces content_urls in cfg/server.yml, for the server
                        and for the clients it tells.
    --games-mode MODE   What happens to a game that is installed and no longer
                        listed: hide (default, kept but not offered), remove
                        (deleted -- only ones install-games installed itself),
                        keep (kept AND offered; the list only adds).
    --refresh           Take the origin's copy of a descriptor even when there
                        is one on the disk. A local game.yml is an operator's
                        file and is never overwritten without this.
    --no-install        Start without asking the origin for anything.
    --map ID            Start that game on this map instead of its own default.
                        `+map ID` after a -- does the same thing and is the
                        spelling every other dedicated server uses. A game that
                        has no maps, or has not got this one, says so and boots
                        on its default anyway.
    --auto-update MODE  when-needed (default): if the addon lock or the pinned web
                        shell on this checkout's branch has moved, or a game this server installs needs
                        newer addons than it has, pull this checkout and move the
                        addons to its lock (what a reinstall does), then start.
                        always: do that on every start. never: keep the installed
                        addons and game versions, and say so.
    --web-loader LABEL  Ask the site for this version of the web game loader
                        for this server's players (reported as sv_web_loader).
                        For a server on older addons than the site's default.
                        A version the site has disabled is ignored and players
                        get the default.

    --config DIR        Where the YAML lives.            (cfg)
    --content DIR       Where the games live.            (content)
    --data DIR          Where the server writes.         (data)

    --base URL          Where the exported engine will be served from. Baked into
                        web/build/tmc-loader.js, which the site uploads as the
                        app's web game loader. export-web and stamp-loader.

                        It MUST be an origin of its own, not a path on the site.
                        The loader frames the engine with a sandbox that is only
                        a boundary while the frame is cross-origin, and refuses
                        to start if this resolves to the page's own origin.

    --platform TARGET   export-native only. linux, windows, macos, or all.
                        The default is all three: a build published for one
                        machine is a Library entry every other machine is told
                        nothing about, and the exports are minutes, not hours.

    --build-version V   export-native only. What the publisher calls this build.
                        Dotted numeric, because the desktop app COMPARES it to
                        decide whether an install is out of date. The default is
                        1.<yyyymmdd>.<hhmm> in UTC, which always beats the one
                        before it -- a constant somebody forgets to bump is an
                        update nobody is ever offered.

    --zip               export-web only. Also write web/build.zip, which is what
                        the site's app form takes: its publisher accepts one .zip
                        and rejects a directory. Off by default -- a standalone
                        deployment serves the directory and does not need a copy.

    --godot PATH        Use this runtime.
    --verbose           Debug logging.
    --dry-run           Print the command that would run, and exit.
    -h, --help

  Anything after -- is handed to the server console once it is up:

    ./server -- +sv_cheats 1 +changelevel arena

  With one exception, and it is the one worth knowing: `+map ID` is read by the
  HOST, not by the console. The console's +command half runs when the listener
  opens, which is before any game is loaded, so the `map` command it would be
  looking for belongs to a module that does not exist yet -- which is why it did
  nothing at all until it was made an option in its own right.

    ./server --game g2gfast -- +map bhop_g2g_intro

  Where the configuration actually lives

  IN cfg/, AS YAML. `cfg/net.yml` has net_port and net_bind_ip; `cfg/server.yml`
  has sv_name and sv_maxplayers; and so on. That is the normal place to change
  any of this, and the only one where the comment explaining why survives.

  Four layers, later winning:

    exported defaults  <  cfg/*.yml  <  DOT_SERVER_*  <  command line

  DOT_SERVER_* is dot-server's own environment layer and sits in the RIGHT place
  -- above the file, below an argument. `DOT_SERVER_SV_MAXPLAYERS=32` is a nudge
  a `--max-players` still beats. It is the one to reach for on a live box.

  TMC_* is not a fifth layer

  Every option above also reads a TMC_ variable, for a container or a unit file
  with no cfg/ to edit. Each becomes the matching ARGUMENT, so it lands in the
  last column and OUTRANKS THE YAML:

    TMC_PORT            --port                TMC_CONFIG_DIR    --config
    TMC_BIND            --bind                TMC_CONTENT_DIR   --content
    TMC_RCON_PORT       --rcon-port           TMC_QUERY_PORT    --query-port
    TMC_A2S_PORT        --a2s-port            TMC_QUERY_BIND    --query-bind
    TMC_NAME            --name                TMC_DATA_DIR      --data
    TMC_MAX_PLAYERS     --max-players         TMC_GODOT         --godot
    TMC_GAME            --game                TMC_ENGINE_BASE   --base
    TMC_MAP             --map                 TMC_EXPORT_ZIP    --zip
    TMC_GAMES           --games               TMC_GAMES_MODE    --games-mode
    TMC_CONTENT_URL     --content-url         TMC_NO_INSTALL    --no-install
    TMC_NATIVE_PLATFORM --platform            TMC_BUILD_VERSION --build-version
    TMC_VERBOSE         --verbose (set to anything)
    TMC_ALLOW_WEB       +sv_allow_web         TMC_ALLOW_DESKTOP +sv_allow_desktop
    TMC_ALLOW_MOBILE    +sv_allow_mobile      (1 admits, 0 refuses; empty = the YAML)
    TMC_WEB_LOADER      --web-loader          TMC_AUTO_UPDATE   --auto-update

  Which means a TMC_PORT left set in an environment file makes cfg/net.yml look
  broken: the port is edited, the server restarts, and it binds the old one with
  nothing saying why. Set them when there is no file to edit, and treat the YAML
  for that key as dead once you have. deploy/env.example ships them commented
  out for this reason.

  One server, not a stack

  This starts ONE. `demo.sh` is what stands up five behind nginx, each with its
  own port and game, and it passes all of this per server itself.

  Secrets are deliberately NOT options, and NOT environment variables either.
  argv is readable by every other process on the machine via ps, the environment
  is readable via /proc/<pid>/environ, and both end up in pasted bug reports --
  which is why DotConfig refuses secrets from argv and the environment alike.
  rcon_password lives in cfg/rcon.yml, which is a file with a mode on it.
USAGE
}

# --- Arguments -------------------------------------------------------------

case "${1:-}" in
    run|check|config|games|export-web|export-native|stamp-loader) COMMAND="$1"; shift ;;
    install-games|index) COMMAND="$1"; shift ;;
    pack|publish)
        COMMAND="pack"; shift
        PACK_ID="${1:-}"
        [ -n "${PACK_ID:-}" ] || die "pack needs a content id, or --all: ./server pack avatars" 2
        shift ;;
    verify)
        COMMAND="verify"; shift
        PACK_ID="${1:-}"
        [ -n "${PACK_ID:-}" ] || die "verify needs a content id: ./server verify avatars" 2
        shift ;;
esac

while [ $# -gt 0 ]; do
    case "$1" in
        --port)        [ $# -ge 2 ] || die "$1 needs a value"; OPT_PORT="$2";        shift 2 ;;
        --bind)        [ $# -ge 2 ] || die "$1 needs a value"; OPT_BIND="$2";        shift 2 ;;
        --rcon-port)   [ $# -ge 2 ] || die "$1 needs a value"; OPT_RCON_PORT="$2";   shift 2 ;;
        --query-port)  [ $# -ge 2 ] || die "$1 needs a value"; OPT_QUERY_PORT="$2";  shift 2 ;;
        --a2s-port)    [ $# -ge 2 ] || die "$1 needs a value"; OPT_A2S_PORT="$2";    shift 2 ;;
        --query-bind)  [ $# -ge 2 ] || die "$1 needs a value"; OPT_QUERY_BIND="$2";  shift 2 ;;
        --name)        [ $# -ge 2 ] || die "$1 needs a value"; OPT_NAME="$2";        shift 2 ;;
        --max-players) [ $# -ge 2 ] || die "$1 needs a value"; OPT_MAX_PLAYERS="$2"; shift 2 ;;
        --game)        [ $# -ge 2 ] || die "$1 needs a value"; OPT_GAME="$2";        shift 2 ;;
        --games)       [ $# -ge 2 ] || die "$1 needs a value"; OPT_GAMES="$2";       shift 2 ;;
        --content-url) [ $# -ge 2 ] || die "$1 needs a value"; OPT_CONTENT_URL="$2"; shift 2 ;;
        --games-mode)  [ $# -ge 2 ] || die "$1 needs a value"; GAMES_MODE="$2";      shift 2 ;;
        --no-install)  NO_INSTALL=1;     shift ;;
        --refresh)     REFRESH=1;        shift ;;
        --map)         [ $# -ge 2 ] || die "$1 needs a value"; OPT_MAP="$2";         shift 2 ;;
        --web-loader)  [ $# -ge 2 ] || die "$1 needs a value"; OPT_WEB_LOADER="$2";  shift 2 ;;
        --auto-update) [ $# -ge 2 ] || die "$1 needs a value"; AUTO_UPDATE="$2";     shift 2 ;;
        --base)    ENGINE_BASE="${2:-}"; shift 2 ;;
        --platform) [ $# -ge 2 ] || die "$1 needs a value"; NATIVE_PLATFORM="$2"; shift 2 ;;
        --build-version) [ $# -ge 2 ] || die "$1 needs a value"; BUILD_VERSION="$2"; shift 2 ;;
        --config)  CONFIG_DIR="${2:-}";  shift 2 ;;
        --content) CONTENT_DIR="${2:-}"; shift 2 ;;
        # pack only. The tree to publish AS this pack, when it is not the content
        # directory -- which for a game is every time: setup.sh vendors all five into one
        # game/ and one scenes/, so no directory here is any single game.
        --source)  PACK_SOURCE="${2:-}"; shift 2 ;;
        --data)    DATA_DIR="${2:-}";    shift 2 ;;
        --godot)   GODOT="${2:-}";       shift 2 ;;
        --verbose) VERBOSE="--verbose";  shift ;;
        --zip)     WANT_ZIP=1;           shift ;;
        --dry-run) DRY_RUN=1;            shift ;;
        -h|--help) usage; exit 0 ;;
        --) shift; PASSTHROUGH=("$@"); break ;;
        --rcon-password|--password)
            die "secrets are not accepted on a command line; put it in $CONFIG_DIR/server.yml" ;;
        *) die "unknown option: $1  (./server --help)" ;;
    esac
done

# [b]Which platforms may join, from a panel.[/b] sv_allow_web / sv_allow_desktop /
# sv_allow_mobile are console cvars and live in cfg/server.yml like any other -- but a
# panel's owner works in variables, not files, so TMC_ALLOW_* reach the same cvars as
# `+sv_allow_* <v>`. Put BEFORE anything typed after `--`, so a hand-written `+sv_allow_web`
# on the command line still has the last word. Empty leaves the YAML in charge.
PLATFORM_ARGS=()
for pair in "web:${TMC_ALLOW_WEB:-}" "desktop:${TMC_ALLOW_DESKTOP:-}" "mobile:${TMC_ALLOW_MOBILE:-}"; do
    value="${pair#*:}"
    [ -n "$value" ] && PLATFORM_ARGS+=("+sv_allow_${pair%%:*}" "$value")
done
PASSTHROUGH=(${PLATFORM_ARGS[@]+"${PLATFORM_ARGS[@]}"} ${PASSTHROUGH[@]+"${PASSTHROUGH[@]}"})

# Built here rather than during parsing: see OPT_* above. An empty value is absent
# rather than a flag with nothing after it, which is how "the environment did not set
# this" and "somebody asked for the empty string" stay different.
[ -n "$OPT_PORT" ]        && OVERRIDES+=(--port "$OPT_PORT")
[ -n "$OPT_BIND" ]        && OVERRIDES+=(--bind "$OPT_BIND")
[ -n "$OPT_RCON_PORT" ]   && OVERRIDES+=(--rcon-port "$OPT_RCON_PORT")
[ -n "$OPT_QUERY_PORT" ]  && OVERRIDES+=(--query-port "$OPT_QUERY_PORT")
[ -n "$OPT_A2S_PORT" ]    && OVERRIDES+=(--a2s-port "$OPT_A2S_PORT")
[ -n "$OPT_QUERY_BIND" ]  && OVERRIDES+=(--query-bind "$OPT_QUERY_BIND")
[ -n "$OPT_NAME" ]        && OVERRIDES+=(--name "$OPT_NAME")
[ -n "$OPT_MAX_PLAYERS" ] && OVERRIDES+=(--max-players "$OPT_MAX_PLAYERS")
[ -n "$OPT_GAME" ]        && OVERRIDES+=(--game "$OPT_GAME")
[ -n "$OPT_MAP" ]         && OVERRIDES+=(--map "$OPT_MAP")
[ -n "$OPT_WEB_LOADER" ]  && OVERRIDES+=(--web-loader "$OPT_WEB_LOADER")
[ -n "$OPT_CONTENT_URL" ] && OVERRIDES+=(--content-url "$OPT_CONTENT_URL")

# [b]The list reaches the SERVER too, and not only the installer.[/b] Installing the two
# games this box is for does not by itself stop it offering the eight already sitting in
# its content directory -- a development tree, a box that was reinstalled onto, or any
# checkout of this repository has all of them -- so a panel that says "arena, g2gfast"
# would be describing a server whose vote menu offered ten. `keep` is the one mode that
# deliberately does not narrow it.
[ -n "$OPT_GAMES" ] && [ "$GAMES_MODE" != "keep" ] && OVERRIDES+=(--games "$OPT_GAMES")

# --- The runtime -----------------------------------------------------------

if [ ! -x "$GODOT" ]; then
    if command -v "$GODOT" >/dev/null 2>&1; then
        GODOT="$(command -v "$GODOT")"
    else
        # The cache setup.sh downloads into is searched too, and before PATH. The
        # baked path above is normally that same file; this is what makes ./server
        # survive the cache moving, or being written on one box and run on another
        # that ran setup.sh for itself.
        CACHE_ROOT="${TMC_GODOT_CACHE:-${XDG_CACHE_HOME:-${HOME:-/nonexistent}/.cache}/tmc/godot}"
        FOUND=""
        # [b]`$PROJECT/.runtime` is in this list because a panel moves the project.[/b]
        # Pterodactyl installs a server with its volume mounted at /mnt/server and RUNS it
        # with the same volume at /home/container, and the egg puts the runtime on the
        # volume -- so the absolute path setup.sh baked in above names a directory that
        # exists only during the install, and TMC_GODOT_CACHE, which named it, is not set
        # at startup either. Every candidate that followed was an absolute path or a PATH
        # lookup, so a correctly installed server died with "no Godot runtime found" on a
        # box where the runtime was sitting beside it. A path relative to the project is
        # the one form that survives the volume being mounted somewhere else.
        for candidate in "$CACHE_ROOT"/*/godot "$PROJECT"/.runtime/*/godot \
                "$PROJECT"/.godot-runtime/*/godot godot godot4 Godot; do
            if [ -x "$candidate" ] && [ ! -d "$candidate" ]; then FOUND="$candidate"; break; fi
            if command -v "$candidate" >/dev/null 2>&1; then FOUND="$(command -v "$candidate")"; break; fi
        done
        [ -n "$FOUND" ] || die "no Godot runtime found. Run ./setup.sh, or ./server --godot /path/to/godot" 3
        GODOT="$FOUND"
    fi
fi

[ -f "$PROJECT/project.godot" ] || die "no Godot project at $PROJECT" 4

# [b]This file is GENERATED, and `git pull` does not update it.[/b] It is written by
# setup.sh from tools/server.in and is gitignored, so pulling a fix to the launcher
# changes the template and leaves the script an operator actually runs exactly as it
# was. The symptom is a bug that is fixed upstream, fixed in the working tree, and
# still happening -- with `git log` showing the fix. Reported by an operator who
# pulled a launcher fix twice and asked whether they needed to run setup again.
#
# They did. So it says so, rather than letting them find out.
#
# A warning and not a refusal: a newer template is not a broken launcher, and a
# server that would not start because a file it generates from is newer than itself
# would be a worse failure than the one this prevents.
if [ -f "$PROJECT/tools/server.in" ] && [ "$PROJECT/tools/server.in" -nt "$SELF" ]; then
    printf '  %stools/server.in is newer than this script -- re-run ./setup.sh to regenerate it%s\n' \
        "$YLW" "$OFF" >&2
fi

VERSION="$("$GODOT" --version 2>/dev/null | head -1)"
case "$VERSION" in
    4.[4-9]*|4.[1-9][0-9]*|5.*) ;;
    "") die "could not run $GODOT --version" 3 ;;
    *) die "Godot 4.4 or newer is required; $GODOT is $VERSION" 3 ;;
esac

# --- Directories -----------------------------------------------------------

abs() { case "$1" in /*) printf '%s' "$1" ;; *) printf '%s/%s' "$PROJECT" "$1" ;; esac; }

[ -d "$(abs "$CONFIG_DIR")" ]  || die "no config directory at $(abs "$CONFIG_DIR")  (run ./setup.sh)" 5
# [b]Created rather than refused when this box is about to install into it.[/b] A server
# whose games all arrive from a content origin has no reason to carry a content directory
# in advance -- the first thing it does is write descriptors into one. Refusing there
# turns "nothing is installed yet" into exit 7 and a message about a directory, which is
# the same message a typo produces and is not the same problem.
#
# Only when a list says something is coming. With no TMC_GAMES, an absent content
# directory really is a typo or a broken install, and the refusal is the right answer.
if [ ! -d "$(abs "$CONTENT_DIR")" ] && [ -n "$OPT_GAMES" ] && [ -z "$NO_INSTALL" ]; then
    mkdir -p "$(abs "$CONTENT_DIR")" 2>/dev/null
fi

[ -d "$(abs "$CONTENT_DIR")" ] || die "no content directory at $(abs "$CONTENT_DIR")" 7
mkdir -p "$(abs "$DATA_DIR")"  || die "could not create $(abs "$DATA_DIR")" 5

# --- Is something already on the port? --------------------------------------
#
# [b]Exit code 6 has been documented at the top of this file since it was written and
# was never once returned.[/b] A dot-server that cannot bind exits with Godot's own
# code and a line in the middle of its boot log, so a supervisor reading these codes
# restarts it forever against a port somebody else owns -- which is precisely the case
# the code was invented to distinguish.
#
# A one-key read of the YAML, not a parser. tools/rcon.mjs makes the same choice for
# the same reason: a second parser here would drift from the one the server uses.
cfg_value() { sed -n "s/^[[:space:]]*$2[[:space:]]*:[[:space:]]*\"\?\([^\"#]*\)\"\?.*/\1/p" "$1" 2>/dev/null | head -1 | tr -d '[:space:]'; }

port_busy() { ss -ltn 2>/dev/null | grep -qE "[:.]$1[[:space:]]"; }

if [ "$COMMAND" = "run" ]; then
    PORT=""
    for ((n = 0; n < ${#OVERRIDES[@]} - 1; n++)); do
        [ "${OVERRIDES[n]}" = "--port" ] && PORT="${OVERRIDES[n + 1]}"
    done
    [ -n "$PORT" ] || PORT="$(cfg_value "$(abs "$CONFIG_DIR")/net.yml" net_port)"

    # Digits, and not merely non-empty: a `net_port` line somebody has commented out or
    # written as `${PORT}` reaches here as text, and `$((PORT + 1))` on text is a shell
    # error in the middle of a launcher rather than a server that starts.
    case "$PORT" in ''|*[!0-9]*) PORT="" ;; esac

    if [ -n "$PORT" ] && command -v ss >/dev/null 2>&1; then
        port_busy "$PORT" && die "port $PORT is already in use. Stop what is on it, or ./server --port N" 6
        # And the RCON listener, which is the half nobody thinks of: two servers a
        # single port apart collide here and nowhere else, and the message the loser
        # prints names a port that looks free.
        #
        # [b]`rcon_port` is read, not assumed.[/b] This used to test `PORT + 1` flatly,
        # which is only the DEFAULT -- `cfg/rcon.yml` ships `rcon_port: 0` with "0 uses
        # the game port + 1" written beside it, so a number there is an override the
        # server honours. The launcher did not, so setting it moved the listener and
        # refused to start anyway, insisting a port the operator had just vacated was
        # "where RCON listens". A check that contradicts the setting it is checking is
        # worse than no check.
        #
        # Searched across the config files rather than in rcon.yml alone, because every
        # one of them is merged into the same cvar space and an operator who put it in
        # server.yml is not wrong.
        # [b]And RCON may simply be off, in which case nothing binds that port at all.[/b]
        # `dot_server.gd` starts the listener only when `rcon_password` is non-empty and
        # `DotRconServer.start` returns early otherwise, so an empty password IS the
        # documented way to turn it off -- and this check refused to start anyway,
        # naming a listener that was never going to exist. Reported by an operator who
        # had disabled RCON, blanked the password, and was still told the port was
        # needed for it.
        #
        # Only whether it is EMPTY is read. The value is a secret and never leaves this
        # test.
        RCON_ON=""
        for f in rcon server net; do
            [ -n "$RCON_ON" ] && break
            [ -n "$(cfg_value "$(abs "$CONFIG_DIR")/$f.yml" rcon_password)" ] && RCON_ON=1
        done

        # [b]The override outranks the file, exactly as it does in the engine.[/b] This
        # is the same bug the comment above describes, one layer up: the launcher used
        # to read only the YAML, so `--rcon-port` moved the listener and the preflight
        # still refused to start over the port it had just vacated. A check that
        # contradicts the setting it is checking is worse than no check.
        RCON_PORT=""
        [ -z "$RCON_ON" ] && RCON_PORT="skip"
        if [ -n "$RCON_ON" ] && [ -n "$OPT_RCON_PORT" ]; then
            RCON_PORT="$OPT_RCON_PORT"
            RCON_WHY="--rcon-port"
        fi
        for f in rcon server net; do
            [ "$RCON_PORT" = "skip" ] && break
            [ -n "$RCON_PORT" ] && break
            RCON_PORT="$(cfg_value "$(abs "$CONFIG_DIR")/$f.yml" rcon_port)"
            case "$RCON_PORT" in ''|*[!0-9]*|0) RCON_PORT="" ;; esac
        done

        if [ "$RCON_PORT" = "skip" ]; then
            RCON_PORT=""
        elif [ -n "$RCON_PORT" ]; then
            [ -n "${RCON_WHY:-}" ] || RCON_WHY="rcon_port"
        else
            RCON_PORT="$((PORT + 1))"
            RCON_WHY="the game port plus one"
        fi

        [ -n "$RCON_PORT" ] && port_busy "$RCON_PORT" && die "port $RCON_PORT is in use, and that is where RCON listens ($RCON_WHY).

  Set rcon_port in $CONFIG_DIR/rcon.yml to move it, or stop what is on that port." 6
    fi
fi

# --- The command -----------------------------------------------------------

# Write web/build/tmc-loader.js from the template with the engine's location baked
# in. It HAS to be baked: the site serves that file out of its own upload store,
# nowhere near the engine, so nothing the loader can read at runtime finds index.js
# — and the one runtime channel that could carry it, the app's play options, is a
# form the PLAYER fills in. See the note on ENGINE_BASE in web/tmc-loader.js.
#
# export-web calls this after building; stamp-loader calls it alone, because moving
# the engine to another domain should not mean re-exporting a game that has not
# changed.
stamp_loader() {
    [ -f "$PROJECT/web/tmc-loader.js" ] || return 0

    if [ -n "$ENGINE_BASE" ]; then
        # An origin, not a path. The loader refuses a same-origin base at runtime
        # anyway, but that failure lands in a player's browser console; this one
        # lands in the terminal of the person who typed it.
        case "$ENGINE_BASE" in
            https://*|http://*) ;;
            *) die "--base must be an absolute URL with a scheme: $ENGINE_BASE" ;;
        esac
        case "$ENGINE_BASE" in
            */) ;;
            *) ENGINE_BASE="$ENGINE_BASE/" ;;
        esac
    else
        # Only true of a STANDALONE deployment. The loader prefers `boot.game` --
        # which the site computes from the app's published build -- and falls back
        # to this stamp, so an unstamped loader behind a play centre is fine and an
        # unstamped one serving itself is not. Saying "will refuse to start" flatly
        # sends somebody hunting for a problem they do not have.
        printf '  %s--base was not given: the stamp is empty. Fine if the site publishes\n' "$YLW" >&2
        printf '   this app (its own build location wins); the loader cannot start\n' >&2
        printf '   without it if you are serving the engine yourself.%s\n' "$OFF" >&2
    fi

    sed "s|@ENGINE_BASE@|$ENGINE_BASE|g" "$PROJECT/web/tmc-loader.js" \
        > "$PROJECT/web/build/tmc-loader.js"
    printf '  tmc-loader.js  engine base: %s\n' "${ENGINE_BASE:-<unset>}"
}

# --- Publishing ------------------------------------------------------------
#
# [b]`./server pack` named a scene that was never written.[/b] It ran
# `res://tools/publish.tscn`, Godot said "Cannot open file", and the launcher exited
# **0** -- so every caller was told it had worked, including `export-web`, which refuses
# to build when a map "is not in the build and is not published" and names this command
# as the fix. The publisher itself was never missing: `DotCloudPublisher` and a complete
# `dot_cloud_cli.gd` -- publish, keygen, verify, inspect -- have been in dot-cloud all
# along. Only the wiring was absent, and it failed in the direction that reports success.
#
# [b]It publishes CONTENT, not games.[/b] The old signature took a game id and passed
# `--game`, which meant the one route from a directory to a mountable pack ran through
# the game index -- so an avatar set, a prop pack or a texture set had no way to be
# published at all, however correctly it was authored. Anything under `content/` can be
# published now, and a game is one case of it.

CLOUD_CLI="res://addons/dot_cloud/publish/dot_cloud_cli.gd"
PACK_TOOL="res://tools/pack.gd"

# The signing key. `client/content.json` ships `require_signed_manifests: true`, so a
# pack published without one mounts nowhere: dot-cloud refuses an unsigned manifest
# because a pack can contain scripts. Publishing unsigned would therefore produce a
# directory that looks finished, serves cleanly, and is silently unusable by every
# client -- so this refuses instead, which is the whole lesson of the command it
# replaces.
SIGNING_KEY="${TMC_SIGNING_KEY:-$PROJECT/keys/content.key}"
PUBLIC_KEY="${TMC_PUBLIC_KEY:-$PROJECT/keys/content.pub}"

do_pack() {
    [ -f "$SIGNING_KEY" ] || die "no signing key at $SIGNING_KEY

  A pack has to be signed. data/content.json and client/content.json both carry
  require_signed_manifests: true, because a pack can contain scripts -- so an
  unsigned one is refused by every client and publishing it would produce a
  directory that looks finished and mounts nowhere.

  Make one once, keep the private half off the content host:
      $GODOT --headless --path $PROJECT --script $CLOUD_CLI -- \
          keygen --private keys/content.key --public keys/content.pub

  Then put the PUBLIC half in client/content.json under trusted_keys." 5

    local args=(--headless --path "$PROJECT" --script "$PACK_TOOL" --
                --content "$(abs "$CONTENT_DIR")" --out "$PROJECT/dist" --key "$SIGNING_KEY")

    if [ "$PACK_ID" = "--all" ] || [ "$PACK_ID" = "all" ]; then
        args+=(--all)
    else
        args+=(--id "$PACK_ID")
    fi

    [ -n "${PACK_SOURCE:-}" ] && args+=(--source "$(abs "$PACK_SOURCE")")
    [ -n "${TMC_MIRROR:-}" ] && args+=(--mirror "$TMC_MIRROR")

    "$GODOT" "${args[@]}" || exit 7

    note "serve dist/ over HTTP, or leave it here -- a server searches dist/ before the network"
    exit 0
}

INSTALL_TOOL="res://tools/install_games.gd"

## True when cfg/content.yml names maps, whose newest versions install-games resolves.
has_owner_maps() {
    [ -f "$CONFIG_DIR/content.yml" ] && grep -qE '^[[:space:]]+maps:' "$CONFIG_DIR/content.yml"
}

## True when cfg/addons.yml names a pack (an uncommented owner/pack anywhere in it), whose
## newest version install-games resolves, prefetches and checks against this build.
has_owner_addons() {
    [ -f "$CONFIG_DIR/addons.yml" ] \
        && grep -vE '^[[:space:]]*#' "$CONFIG_DIR/addons.yml" | grep -qE '[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+'
}
INDEX_TOOL="res://tools/index.gd"

## True when cfg/content/games.yml lists a pack (`pack:` or an owner/name), which install-games fetches.
has_listed_packs() {
    local f
    for f in "$CONFIG_DIR/content/games.yml" "$CONFIG_DIR/server/content/games.yml"; do
        [ -f "$f" ] && grep -vE '^[[:space:]]*#' "$f" | grep -qE 'pack:|^[[:space:]]*-[[:space:]]+[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+' && return 0
    done
    return 1
}

## Fetch the descriptors and the packs for TMC_GAMES. Returns the tool's exit code:
## 0 everything asked for is here, 2 none of it is, 3 some of it is not.
do_install_games() {
    if [ -z "$OPT_GAMES" ]; then
        note "no games list: TMC_GAMES, --games arena,g2gfast, or packs in cfg/content/games.yml"
        note "without one this server offers whatever is already in $CONTENT_DIR"
        # The maps an owner added still need a version each; the tool resolves only those.
        has_owner_maps || has_owner_addons || has_listed_packs || return 0
    fi

    local args=(--headless --path "$PROJECT" --script "$INSTALL_TOOL" --
                --games "$OPT_GAMES"
                --content "$CONTENT_DIR" --data "$DATA_DIR" --config "$CONFIG_DIR")

    [ -n "$OPT_CONTENT_URL" ] && args+=(--base "$OPT_CONTENT_URL")
    [ "$GAMES_MODE" = "remove" ] && args+=(--prune)
    [ -n "$REFRESH" ] && args+=(--refresh)
    [ -n "$VERBOSE" ] && args+=(--verbose)

    "$GODOT" "${args[@]}"
    return $?
}

do_index() {
    "$GODOT" --headless --path "$PROJECT" --script "$INDEX_TOOL" -- \
        --content "$(abs "$CONTENT_DIR")" --out "$PROJECT/dist" || exit 7

    note "upload dist/ as usual -- games.json and descriptors/ ride with the packs"
    exit 0
}

do_verify() {
    local manifest="$PROJECT/dist/$PACK_ID/manifest.json"

    [ -f "$manifest" ] || die "nothing published at dist/$PACK_ID (./server pack $PACK_ID)" 7
    [ -f "$PUBLIC_KEY" ] || die "no public key at $PUBLIC_KEY" 5

    "$GODOT" --headless --path "$PROJECT" --script "$CLOUD_CLI" -- \
        verify --manifest "$manifest" --public "$PUBLIC_KEY" || exit 7

    exit 0
}

# --- Native builds ---------------------------------------------------------
#
# [b]The desktop app installs a file, and until this command there was nothing to give
# it.[/b] `export_presets.cfg` held one preset -- Web -- so the browser was the only way
# to play anything on this platform, and the app's Games tab correctly reported that
# nothing was published for this machine. The presets now ship in
# `export_presets.example.cfg`, setup copies them in, and this builds them.
#
# [b]One file per platform, because an install is a download.[/b] `binary_format/
# embed_pck=true` puts the pack inside the executable, so there is no second file to
# lose, to mismatch, or to forget in an archive -- and the archive then holds exactly
# one entry, which is the `--entry` the publisher wants.
#
# [b]It is the CLIENT, not the server.[/b] Every preset excludes `host/*` exactly as the
# Web one does: `client/shell.tscn` is the main scene, a player who double-clicks gets a
# menu and a server address, and an operator runs `./server`. A native build that could
# also host is a different product and would ship a different preset.
#
# THE LAUNCH ARGUMENTS NEED THE BARE `--`, and this is the part that is easy to get
# wrong twice. `client/shell.gd` reads the address from `OS.get_cmdline_user_args()`,
# which is *only* what follows a `--` on the command line; Godot 4 silently ignores an
# argument it does not recognise rather than refusing to start, so
# `tmc.x86_64 --connect host:port` runs perfectly, shows the menu, and connects to
# nothing. `--args "--,--connect,{host}:{port},--udp,{host}:{udpPort}"` is the
# spelling that works, and the app's own argument builder drops a pair cleanly when its
# value is missing: no server chosen, or a server that advertises no ENet port
# (`{udpPort}` is the server's own A2S `udp:<port>` keyword, carried by the site).

# [b]An imported map must NOT be in a pack, and MUST be on the CDN.[/b] Shared by both
# export commands, because either build reaches a player who then has to fetch those maps
# from the content origin -- 66 MB of converted geometry that is published one pack per
# map, so a player downloads the map the server is on rather than every map it could be
# on. The game's own `pack.json` excludes the directory; this checks the other half.
#
# The second half is the one worth having. A map excluded from the build and never
# published is a map nobody can reach, and the symptom -- G2GBspMap reads the manifest
# first, so the spawn point, the zone set, the start line and the pit are built over no
# geometry at all -- is a player who connects, signs on, spawns, and sees sky in every
# direction. Reported on a server, a day later, by somebody who thought the map was
# broken.
## The export templates, fetched at the moment they are first needed.
##
## [b]Not part of setting the project up, and not left to the operator either.[/b] The
## archive is about a gigabyte, so a server that will only ever run games should not
## pay for it -- but a box that has never exported anything fails like this:
##
##     ERROR: Cannot export project with preset "Web" due to configuration errors:
##     No export template found at the expected path:
##     ~/.local/share/godot/export_templates/4.7.2.stable/web_nothreads_debug.zip
##
## which names a path nobody configured, for a file nothing here ever downloaded. The
## runtime had exactly this hole and fetch-godot.sh closed it. This is the same answer
## for the other half, at the only moment it is certainly wanted: somebody has just
## asked for an export.
##
## TMC_NO_DOWNLOAD opts out, the same switch that stops the runtime being fetched --
## a policy that says binaries arrive another way means all of them, not some.
ensure_export_templates() {
    local fetch="$PROJECT/tools/fetch-export-templates.sh"

    [ -x "$fetch" ] || return 0
    "$fetch" --check >/dev/null 2>&1 && return 0

    if [ -n "${TMC_NO_DOWNLOAD:-}" ]; then
        die "no export templates for this engine, and TMC_NO_DOWNLOAD is set.

    Install them yourself, or unset it and let this fetch them:
        tools/fetch-export-templates.sh" 3
    fi

    printf '\n  %sexport templates%s\n' "$BLD" "$OFF"
    "$fetch" >/dev/null || die "could not install the export templates" 3
}


## Every preset carries `addons.lock`: the export's record of which addon versions it was
## built from.
##
## [b]A client compares it against the addon set a server announces[/b] and fetches the
## newer ones as packs (dot-cloud's `DotCloudAddonSet`), which is what lets an addon release
## reach players without a new shell. A build without it cannot say what is newer, so it
## takes nothing -- silently, as far as the player is concerned. And it is not a resource,
## so `all_resources` leaves it out unless `include_filter` names it.
##
## The tracked presets name it. A copy written before they did is never overwritten (the
## editor owns it), so the line is added here, in place, rather than trusted.
ensure_lock_exported() {
    local cfg="$PROJECT/export_presets.cfg" tmp

    [ -f "$cfg" ] || return 0
    grep -E '^include_filter=' "$cfg" | grep -qvF 'addons.lock' || return 0

    tmp="$(mktemp "$PROJECT/.export_presets.XXXXXX")" || die "could not write a temporary file" 5
    awk '
        /^include_filter=/ && index($0, "addons.lock") == 0 {
            value = substr($0, length("include_filter=\"") + 1)
            sub(/"$/, "", value)
            print "include_filter=\"" (value == "" ? "addons.lock" : value ", addons.lock") "\""
            next
        }
        { print }
    ' "$cfg" > "$tmp" && mv "$tmp" "$cfg" || { rm -f "$tmp"; die "could not update $cfg" 5; }

    printf '  export_presets.cfg now exports addons.lock (a copy older than the tracked presets)\n'
}

# Writes res://client/build_stamp.gd, which client/shell_version.gd reads to show the shell's
# commit on its first screens. Generated per export and git-ignored: a tracked copy would be
# dirty after every export and wrong after every commit. A .gd rather than a data file
# because the presets export resources by default and a data file needs an include_filter
# that an older export_presets.cfg does not have. The web BUILD ID is not stamped here: it
# is chosen at upload, after this runs, and is read back from the page's URL instead.
stamp_shell_version() {
    local short dirty=""

    short="$(git -C "$PROJECT" rev-parse --short=7 HEAD 2>/dev/null)" || short=""

    if [ -z "$short" ]; then
        # Not a checkout (a tarball): no stamp rather than a made-up one.
        rm -f "$PROJECT/client/build_stamp.gd"
        return 0
    fi

    # Untracked files count: the exported tree is the working tree, not the commit.
    [ -n "$(git -C "$PROJECT" status --porcelain 2>/dev/null | grep -v 'client/build_stamp.gd')" ] && dirty="-dirty"

    printf '## Generated by `./server export-web` and `export-native`. Do not edit or commit.\nconst COMMIT := "%s%s"\n' \
        "$short" "$dirty" > "$PROJECT/client/build_stamp.gd"
    # The class cache and the export both need to see the new script.
    printf '  stamped the shell as %s%s\n' "$short" "$dirty"
}

## embed.html's `fileSizes` placeholder, filled from the index.html Godot wrote beside it.
## Skipped quietly when either is missing or the table is unreadable: an empty table is a
## bar that sweeps, which is the old behaviour and not worth failing an export over.
stamp_file_sizes() {
    local build="$1" sizes
    [ -f "$build/index.html" ] && [ -f "$build/embed.html" ] || return 0
    sizes=$(grep -o '"fileSizes":{[^}]*}' "$build/index.html" | head -1 | sed 's/^"fileSizes"://')
    [ -n "$sizes" ] || return 0
    sed -i "s#/\*FILE_SIZES\*/{}#$sizes#" "$build/embed.html"
}

install_ceiling() {
    local build="$1" js="$PROJECT/addons/dot_audio/web/dot_audio_ceiling.js" page
    if [ ! -f "$js" ]; then
        # Warned, not refused: a shell is sometimes exported in a hurry, and one that clips on
        # a pile-up is better than none. The release order tags dot-audio before the shell.
        warn "addons/dot_audio/web/dot_audio_ceiling.js is missing (dot-audio older than the browser's limiter): this web build has no ceiling and a pile-up of sounds will clip"
        return 0
    fi
    cp "$js" "$build/dot_audio_ceiling.js"
    for page in "$build/index.html" "$build/embed.html"; do
        [ -f "$page" ] || continue
        if ! grep -qF 'dot_audio_ceiling.js' "$page"; then
            # Into <head>, ahead of the engine's own script tag.
            sed -i 's#<head>#<head>\n<script src="dot_audio_ceiling.js"></script>#' "$page"
        fi
        grep -qF 'src="dot_audio_ceiling.js"' "$page" \
            || die "$page does not load dot_audio_ceiling.js, so its sound has no ceiling" 3
    done
}

## The export holds `addons.lock`. Checked in the artifact, like the maps, because a filter
## that stopped working is otherwise a shell that never takes a newer addon.
check_lock_exported() {
    grep -qF "addons.lock" "$1" \
        || die "the export does not carry addons.lock, so its players would never take a newer addon.

    The presets' include_filter has to name it; ensure_lock_exported adds it to an older
    export_presets.cfg, so if this fired the file has a filter that does not match." 3
}

check_excluded_maps() {
    local pack="$1" carried=0 unpublished=0 bin rel id

    while IFS= read -r bin; do
        rel="${bin#"$PROJECT"/}"
        id="$(basename "$(dirname "$bin")")"

        if grep -qF "$rel" "$pack"; then
            warn "the export is carrying $rel, which the CDN already serves"
            carried=$((carried + 1))
        fi

        # Published flat (`dist/<id>/`, the old unowned layout) or under an owner
        # (`dist/maps/gamemann/<id>/`, what g2gfast's tools/publish_maps.sh writes and
        # what a server asks for as `<owner>/<id>`). Only looking for the first made
        # every owned map read as unpublished and stopped the export.
        if [ ! -f "$PROJECT/dist/$id/manifest.json" ] \
            && [ -z "$(find "$PROJECT/dist" -path "*/$id/manifest.json" -print -quit 2>/dev/null)" ]; then
            printf '  %s%s is not in the build and is not published%s\n' \
                "$RED" "$id" "$OFF" >&2
            unpublished=$((unpublished + 1))
        fi
    done < <(find "$PROJECT"/../game-*/maps/imported -name '*.bin' 2>/dev/null)

    [ "$carried" -eq 0 ] || warn "$carried map(s) are in the build as well as on the CDN -- the game's pack.json should exclude \"imported\""
    # NAMING THE DIRECTORY IS THE POINT. This said `./server pack <id>` and nothing
    # else, and that command publishes `content/<id>` -- where no imported map has ever
    # lived. Every one of them is under `maps/imported/`, so the remedy as written fails
    # with "no content at content/surf_mesa" and reads like the map is the problem.
    [ "$unpublished" -eq 0 ] || die "$unpublished map(s) reach nobody: not in the build, not in dist/.

  Publish them -- the map id is the content id, and the maps are in the GAME's
  repository rather than under content/ here:

      ./server pack --all --content ../game-g2gfast/maps/imported

  Or put them back in the game's pack by dropping \"imported\" from its pack.json." 3

    # [b]There is no maps/ in this project any more.[/b] The games are published as packs
    # and each one carries its own maps/, so an imported map is now excluded by its
    # GAME's pack.json rather than by this project's exclude_filter -- and the loop above
    # reads the sibling repositories for that reason. What has not changed is the half
    # worth having: a map excluded from a pack and never published reaches nobody.
}

# Zip a directory from INSIDE it, so entries are `tmc.x86_64` rather than
# `linux-x64/tmc.x86_64`. The publisher's `--entry` is a path inside the archive and the
# app joins it to wherever it unpacked -- a leading directory nobody declared is an
# install that lands and then cannot be started.
#
# THE MODE BITS TRAVEL. A Godot export that arrives without `+x` fails at launch with a
# permission error that reads like a broken download; the app re-marks the entry
# executable for exactly that reason, and a zip that carries the bit means it never has
# to. `zip` does this for free; the python fallback has to be told, and there is a
# python fallback because a machine with Godot on it and no `zip` is ordinary enough to
# handle rather than to fail on.
zip_dir() {
    local dir="$1" out="$2"

    rm -f "$out"

    if command -v zip >/dev/null 2>&1; then
        ( cd "$dir" && zip -qr "$out" . ) || die "zip failed" 3
    elif command -v python3 >/dev/null 2>&1; then
        python3 - "$dir" "$out" <<'NATIVE_ZIP_PY' || die "zip failed" 3
import os, sys, zipfile
src, out = sys.argv[1], sys.argv[2]
with zipfile.ZipFile(out, "w", zipfile.ZIP_DEFLATED) as z:
    for root, _dirs, files in os.walk(src):
        for name in files:
            full = os.path.join(root, name)
            info = zipfile.ZipInfo.from_file(full, os.path.relpath(full, src))
            info.compress_type = zipfile.ZIP_DEFLATED
            info.external_attr = (os.stat(full).st_mode & 0xFFFF) << 16
            with open(full, "rb") as fh:
                z.writestr(info, fh.read())
NATIVE_ZIP_PY
    else
        die "need zip or python3 to build the archive" 3
    fi
}

do_export_native() {
    local targets=()

    case "$NATIVE_PLATFORM" in
        all)                        targets=(linux windows macos) ;;
        linux|linux-x64|LINUX_X64)  targets=(linux) ;;
        windows|win|WINDOWS_X64)    targets=(windows) ;;
        macos|mac|MACOS_UNIVERSAL)  targets=(macos) ;;
        *) die "--platform takes linux, windows, macos or all -- not $NATIVE_PLATFORM" 2 ;;
    esac

    [ -f "$PROJECT/export_presets.cfg" ] || die "no export_presets.cfg

  It is not in the repository -- the editor rewrites it, so it is gitignored the
  way cfg/ is. The tracked copy is export_presets.example.cfg:

      cp export_presets.example.cfg export_presets.cfg

  ./setup.sh does this for you." 5

    [ -n "$BUILD_VERSION" ] || BUILD_VERSION="1.$(date -u +%Y%m%d).$(date -u +%H%M)"

    # Godot caches its text->binary scene conversions in .godot/exported/, and --import
    # does NOT invalidate them. setup.sh copies each game's .gd files out of its sibling
    # repository and Godot then mints a FRESH .uid for every one -- so a re-vendored
    # script gets a new uid while the cached conversion of the scene that references it
    # still carries the old one, and the build ships a scene pointing at a uid that
    # exists nowhere. It recovers via the path it also carries, which is why it went
    # unnoticed in the web build for so long. Nothing headless can see it; not reusing
    # the cache is cheap.
    rm -rf "$PROJECT/.godot/exported"

    local target preset outdir binary entry archive api_platform row
    local published=()

    for target in "${targets[@]}"; do
        case "$target" in
            linux)
                preset="Linux x86_64"; outdir="build/linux-x64"; binary="tmc.x86_64"
                entry="tmc.x86_64";    archive="build/tmc-linux-x64.zip"
                api_platform="LINUX_X64" ;;
            windows)
                preset="Windows x86_64"; outdir="build/windows-x64"; binary="tmc.exe"
                entry="tmc.exe";         archive="build/tmc-windows-x64.zip"
                api_platform="WINDOWS_X64" ;;
            macos)
                # Godot writes the .app into a zip of its own when the export path ends
                # in .zip, and it is the only way to keep a bundle's structure and its
                # mode bits on a machine that is not a Mac. The bundle is named from the
                # project name, which is why project.godot carries a `.macos` override:
                # this project is the SERVER tool and what macOS installs is the client.
                preset="macOS"; outdir="build/macos"; binary="tmc.zip"
                entry="TMC.app/Contents/MacOS/TMC"; archive="build/tmc-macos.zip"
                api_platform="MACOS_UNIVERSAL" ;;
        esac

        grep -qF "name=\"$preset\"" "$PROJECT/export_presets.cfg" \
            || die "export_presets.cfg has no preset named \"$preset\". export_presets.example.cfg is the tracked copy that does." 5

        mkdir -p "$PROJECT/$outdir" || die "could not create $PROJECT/$outdir" 5

        ensure_export_templates
        ensure_lock_exported
        stamp_shell_version

        printf '\n  %sexporting %s%s\n' "$BLD" "$preset" "$OFF"

        rm -f "$PROJECT/$outdir/$binary"
        "$GODOT" --headless --path "$PROJECT" \
            --export-release "$preset" "$PROJECT/$outdir/$binary" || exit $?

        # [b]Checked rather than trusted.[/b] `./server pack` named a scene that was
        # never written, Godot said "Cannot open file", and the launcher exited 0 --
        # so every caller was told it had worked. An export can print an error and
        # leave the exit code alone, which makes the artifact existing the only
        # evidence worth acting on.
        [ -s "$PROJECT/$outdir/$binary" ] \
            || die "the $preset export produced no $outdir/$binary.

    Export templates for $VERSION are the usual cause, and
    tools/fetch-export-templates.sh installs them -- this command calls it, so if
    that is what happened it already said so above." 3

        check_excluded_maps "$PROJECT/$outdir/$binary"
        # The macOS artifact is a zip Godot wrote; the pack inside it is compressed.
        [ "$target" = "macos" ] || check_lock_exported "$PROJECT/$outdir/$binary"

        if [ "$target" = "macos" ]; then
            cp "$PROJECT/$outdir/$binary" "$PROJECT/$archive"
        else
            zip_dir "$PROJECT/$outdir" "$PROJECT/$archive"
        fi

        printf '  wrote %s (%s)\n' "$archive" "$(du -h "$PROJECT/$archive" | cut -f1)"
        published+=("$api_platform|$archive|$entry")
    done

    # What to do with what was just built. The publisher lives in website-city, because
    # that is where the database and the CDN credentials are, and printing the command
    # beats describing it: the version, the entry path and the argument list are all
    # things this script knows and a person would otherwise be looking up.
    printf '\n  %spublish them from website-city:%s\n\n' "$BLD" "$OFF"

    for row in "${published[@]}"; do
        api_platform="${row%%|*}"; row="${row#*|}"
        archive="${row%%|*}"; entry="${row#*|}"

        printf '    npm run app:build:publish -- \\\n'
        printf '        --app godot --platform %s --version %s \\\n' "$api_platform" "$BUILD_VERSION"
        printf '        --file %s/%s \\\n' "$PROJECT" "$archive"
        printf '        --entry "%s" \\\n' "$entry"
        printf '        --args "--,--connect,{host}:{port},--udp,{host}:{udpPort}"\n\n'
    done

    # `--app godot` is the ENGINE app, and it is deliberate. A server hangs off the
    # engine app rather than off a game -- it can change which game it is running while
    # players stay connected -- so a Play press resolves the build from there, exactly
    # as the web build does. Publishing the same 80 MB shell again under each game app
    # buys a Library entry per game and costs a copy per game: do that when somebody
    # wants the games listed separately, not by default.
    note "--app godot is the engine app: a server belongs to it, and that is what a"
    note "Play press resolves a build from. See seed-godot-apps.ts."

    exit 0
}

SCENE="res://host/host.tscn"
ARGS=(--headless --path "$PROJECT" "$SCENE" --
      --config "$CONFIG_DIR" --content "$CONTENT_DIR" --data "$DATA_DIR")

case "$COMMAND" in
    check)      ARGS+=(--selftest) ;;
    config)     ARGS+=(--print-config) ;;
    games)      ARGS+=(--list-games) ;;
    pack)       do_pack ;;
    index)      do_index ;;
    install-games)
        do_install_games
        exit $?
        ;;
    verify)     do_verify ;;
    export-native) do_export_native ;;
    export-web)
        ensure_export_templates
        ensure_lock_exported
        stamp_shell_version
        mkdir -p "$PROJECT/web/build"

        # Godot caches its text->binary scene conversions in .godot/exported/, and
        # --import does NOT invalidate them. setup.sh copies each game's .gd files out
        # of its sibling repository and Godot then mints a FRESH .uid for every one --
        # so a re-vendored script gets a new uid while the cached conversion of the
        # scene that references it still carries the old one. The exported build then
        # ships a scene pointing at a uid that exists nowhere:
        #
        #   'res://scenes/room_client.tscn': In external resource #0,
        #   invalid UID: 'uid://bgngka2i7aj5g' - using text path instead
        #
        # It recovers, because these scenes name a path as well as a uid, which is why
        # it went unnoticed: the game loads and the only trace is a red line in the
        # browser console. A scene saved with a uid and no path would not recover.
        # Nothing headless can see it -- the conversion cache is only read when
        # exporting -- so the cheap fix is to not reuse it.
        rm -rf "$PROJECT/.godot/exported"

        "$GODOT" --headless --path "$PROJECT" \
            --export-release "Web" "$PROJECT/web/build/index.html" || exit $?

        # The two things that then have to be true about a map the preset excluded.
        # Shared with `export-native`, which excludes the same directory for the same
        # reason -- the story that put the check here is on the function.
        check_excluded_maps "$PROJECT/web/build/index.pck"
        check_lock_exported "$PROJECT/web/build/index.pck"

        # The standalone page, which takes ?server= from the URL.
        [ -f "$PROJECT/web/embed.html" ] && cp "$PROJECT/web/embed.html" "$PROJECT/web/build/embed.html"

        # The browser's limiter, beside the engine and in both pages, before index.js. A web
        # build in sample playback runs no bus effects, so dot-audio's Master limiter never
        # ran in a browser: a game measured +3.4 dBFS with 187 clipped samples in 40 s
        # (dot-audio docs/loudness.md, "The browser's ceiling"). The file is dot-audio's;
        # embed.html names it in its source, index.html gets it here because the presets
        # are each box's own copy.
        install_ceiling "$PROJECT/web/build"

        # The byte counts of the engine files, from the index.html Godot just wrote, into
        # embed.html: the engine's progress callback only has a total when it is given one.
        stamp_file_sizes "$PROJECT/web/build"

        # And the loader website-city uploads, with the engine's location baked in.
        # It HAS to be baked: the site serves that file out of its own upload store,
        # nowhere near the engine, so nothing the loader can read at runtime finds
        # index.js. An unset base is written anyway and refuses to start with a
        # message naming this flag, which beats a game that fails silently.
        stamp_loader

        # [b]What this build was exported from[/b], inside the build, so it travels with
        # the zip to the bucket. tools/publish-web-shell.sh refuses to pin a build whose
        # record does not match the checkout it pins in (a lock pulled between the export
        # and the pin was the way to pin a shell built from the previous lock), and the
        # release workflow compares the uploaded copy with the tag. tools/shell-inputs.sh.
        if [ -x "$PROJECT/tools/shell-inputs.sh" ]; then
            # Not fatal: a tarball has no git to list the inputs with, and its build can
            # still be served by hand. It just cannot be pinned.
            "$PROJECT/tools/shell-inputs.sh" print > "$PROJECT/web/build/shell-inputs.txt" \
                || { rm -f "$PROJECT/web/build/shell-inputs.txt"
                     warn "no shell-inputs.txt in this build, so tools/publish-web-shell.sh will not pin it"; }
            # The lock is only half of it: on a developer box addons/ links sibling
            # checkouts, usually ahead of their tags, and a shell exported from those is
            # not the shell the lock names (a pin of 2026-10-20 carried three addons
            # ahead of the lock). The pin refuses a build marked off-lock.
            if [ -f "$PROJECT/web/build/shell-inputs.txt" ] \
                    && ! "$PROJECT/tools/addons-lock.sh" check >/dev/null 2>&1; then
                printf 'addons\toff-lock\n' >> "$PROJECT/web/build/shell-inputs.txt"
                warn "the linked addons are not at addons.lock (tools/addons-lock.sh check), so this build will not be pinned"
            fi
        fi
        printf '  wrote %s\n' "$PROJECT/web/build"

        # [b]The archive the site's publisher takes, because a directory is not one.[/b]
        # `GAME_PUBLISH` accepts a single .zip and rejects anything else by extension, and
        # nothing in this repository produced one -- so the documented route from an export
        # to a published build had a manual `zip -r` in the middle of it that was written
        # down nowhere. Off by default: the standalone deployment serves web/build as a
        # directory and has no use for 106 MB of second copy.
        if [ -n "$WANT_ZIP" ]; then
            ZIP_PATH="$PROJECT/web/build.zip"
            rm -f "$ZIP_PATH"

            # [b]Top-level files only.[/b] An export is flat, and web/build is gitignored, so
            # anything else in it is a leftover nobody tracks: a stray `content/` of old
            # packs turned a 17 MB upload into 407 MB (2026-10-15). Skipped loudly, not
            # silently, in case a future export does start writing a subdirectory.
            for extra in "$PROJECT/web/build"/*/; do
                [ -d "$extra" ] && printf '  not zipped (not part of an export): %s\n' "$extra"
            done

            # Zipped from INSIDE the build directory, so entries are `index.wasm` rather
            # than `build/index.wasm`. The extractor rejects a path it did not expect and
            # the publisher would look at a perfectly good archive and find no entry point.
            if command -v zip >/dev/null 2>&1; then
                ( cd "$PROJECT/web/build" && find . -maxdepth 1 -type f ! -name '*.import' -print0 \
                    | xargs -0 zip -q "$ZIP_PATH" ) || die "zip failed" 3
            elif command -v python3 >/dev/null 2>&1; then
                # No `zip` on a machine that has Godot on it is ordinary enough to handle
                # rather than to fail on.
                python3 - "$PROJECT/web/build" "$ZIP_PATH" <<'PY' || die "zip failed" 3
import os, sys, zipfile
src, out = sys.argv[1], sys.argv[2]
with zipfile.ZipFile(out, "w", zipfile.ZIP_DEFLATED) as z:
    for name in sorted(os.listdir(src)):
        full = os.path.join(src, name)
        if os.path.isfile(full) and not name.endswith(".import"):
            z.write(full, name)
PY
            else
                die "need zip or python3 to build the archive; web/build is ready if you would rather make it yourself" 3
            fi

            printf '  wrote %s (%s)\n' "$ZIP_PATH" "$(du -h "$ZIP_PATH" | cut -f1)"
            printf '  upload that in the app form: Play tab, web game build\n'
        fi
        exit 0
        ;;
    stamp-loader)
        [ -n "$ENGINE_BASE" ] || die "stamp-loader needs --base https://games.example.net/"
        mkdir -p "$PROJECT/web/build"
        stamp_loader
        exit 0
        ;;
esac

# [b]Install before boot, and never refuse to boot over it.[/b] A panel has no shell, so
# the only moment a server can fetch what it was configured to run is the moment it
# starts. What it must NOT do is make an unreachable content origin into a server that
# will not start: a box whose games are already installed does not touch the network at
# all, and one that cannot reach the origin says so and comes up with what it has. An
# operator can act on a warning at the top of a log; they cannot act on a server that
# exits before it listens.
# [b]A game that needs newer addons than this box has is the one install failure a
# server can fix by itself.[/b] A box's addons come from addons.lock and move only when
# this checkout is updated and setup.sh --update runs -- a reinstall, on a panel. A
# restart never did it, so a game released against a new addon API was installed,
# refused at boot ("This game needs dot-platform API level 3 or newer; this server has
# level 2"), and the server came up running nothing until somebody reinstalled it
# (2026-10-04). The installer now checks a pack's requires.json first, keeps the version
# that runs, and exits 4; this does the reinstall's two steps and starts again.
#
# Only on a checkout that is a deployment: a shallow clone (what the egg and setup make),
# or one whose HEAD is already contained in origin's branch. A developer's checkout with
# commits of its own is never reset -- that is somebody's work -- and is told to pull.
## Make a deployment checkout resettable, and say what was in the way.
##
## [b]Every panel box refused its own update.[/b] The daemon re-applies file ownership and
## permissions on each start, git counts a changed mode as a local change, and the update
## then declined with "tracked files here have local changes" -- so no box ever moved past
## the addons it was installed with (2026-10-14). A deployment is this script's, not
## somebody's working tree: modes are ignored, and a real edit to a tracked file is set
## aside with `git stash` (named, recoverable with `git stash list`) rather than either
## blocking the update or being thrown away.
clear_for_update() {
    local dir="$1" what="$2"
    git -C "$dir" config core.fileMode false 2>/dev/null
    # The panel's install script deletes the built-in descriptors under content/ that are
    # not in TMC_GAMES -- tracked files, so the checkout it leaves is "dirty" from then
    # on. Those deletions are the installer's own pruning (and TMC_GAMES_MODE hides the
    # games anyway), so they are put back rather than stashed on every start.
    if [ "$dir" = "$PROJECT" ] && [ -n "$(git -C "$dir" ls-files --deleted -- content 2>/dev/null)" ]; then
        git -C "$dir" checkout --quiet -- $(git -C "$dir" ls-files --deleted -- content) 2>/dev/null \
            && note "put back the built-in game descriptors the installer had pruned from content/"
    fi
    local dirty
    dirty="$(git -C "$dir" status --porcelain --untracked-files=no 2>/dev/null)"
    [ -z "$dirty" ] && return 0
    warn "TMC_AUTO_UPDATE: $what had local changes to tracked files; setting them aside:"
    printf '%s\n' "$dirty" | head -n 20 | while IFS= read -r line; do warn "    $line"; done
    git -C "$dir" stash push --quiet -m "tmc auto-update $(date -u +%Y-%m-%dT%H:%MZ 2>/dev/null)" 2>/dev/null \
        || { warn "TMC_AUTO_UPDATE: could not set them aside; not touching $what"; return 1; }
    note "kept in git stash (git -C $dir stash list)"
}

self_update() {
    command -v git >/dev/null 2>&1 \
        || { warn "TMC_AUTO_UPDATE: git is not installed here; reinstall the server to update its addons"; return 1; }
    [ -d "$PROJECT/.git" ] \
        || { warn "TMC_AUTO_UPDATE: $PROJECT is not a git checkout; reinstall to update its addons"; return 1; }

    local branch
    branch="$(git -C "$PROJECT" rev-parse --abbrev-ref HEAD 2>/dev/null)"
    [ -n "$branch" ] && [ "$branch" != "HEAD" ] \
        || { warn "TMC_AUTO_UPDATE: this checkout is not on a branch; not touching it"; return 1; }

    note "updating this checkout (origin/$branch) and moving the addons to its lock"
    GIT_TERMINAL_PROMPT=0 git -C "$PROJECT" fetch --quiet --depth 1 origin "$branch" \
        || { warn "TMC_AUTO_UPDATE: could not fetch origin/$branch"; return 1; }

    # A depth-1 fetch cannot say whether HEAD is behind origin or has commits of its own,
    # so a shallow checkout deepens to HEAD's date first; if HEAD is still not contained,
    # it is somebody's work (or unknowable) and is never reset.
    if [ "$(git -C "$PROJECT" rev-parse --is-shallow-repository)" = "true" ] \
            && ! git -C "$PROJECT" merge-base --is-ancestor HEAD "origin/$branch" 2>/dev/null; then
        local since
        since="$(( $(git -C "$PROJECT" log -1 --format=%ct HEAD 2>/dev/null || echo 0) - 86400 ))"
        GIT_TERMINAL_PROMPT=0 git -C "$PROJECT" fetch --quiet --shallow-since="@$since" origin "$branch" 2>/dev/null \
            || { warn "TMC_AUTO_UPDATE: could not tell whether this checkout has commits of its own; not touching it"; return 1; }
    fi
    if ! git -C "$PROJECT" merge-base --is-ancestor HEAD "origin/$branch" 2>/dev/null; then
        warn "TMC_AUTO_UPDATE: this checkout has commits origin/$branch does not; pull it yourself"
        return 1
    fi

    clear_for_update "$PROJECT" "this checkout" || return 1

    git -C "$PROJECT" reset --quiet --hard "origin/$branch" || return 1
    (cd "$PROJECT" && ./setup.sh --no-games --update) || { warn "TMC_AUTO_UPDATE: setup.sh --update failed"; return 1; }
    note "updated to $(git -C "$PROJECT" rev-parse --short HEAD)"
}

## Update, then run this script again from the top -- setup.sh regenerates it, and the new
## lock means a new everything. Once: TMC_AUTO_UPDATED stops a second pass looping on a
## game the newest lock still cannot run.
update_and_restart() {
    if self_update; then
        export TMC_AUTO_UPDATED=1
        exec "$PROJECT/server" "${ORIG_ARGS[@]}"
    fi
    return 1
}

## Whether the addon lock on origin's branch differs from this checkout's.
##
## [b]An addon release is a lock bump, and a lock bump has to reach a box by a restart.[/b]
## Players fetch newer addons as packs when the server they join says it runs them (see
## `TmcHost._advertise_addons`); a server says what its lock says. So a lock pushed to the
## deploy branch reached no player until each box was reinstalled -- `when-needed` updated
## only for a game that refused to run, and an addon fix makes no game refuse anything.
##
## One shallow fetch per start, and every reason not to answer is "no": no git, not a
## checkout, not on a branch, local changes, a developer's own commits, an origin that does
## not answer in twenty seconds. A box that cannot ask starts on what it has, quietly; the
## reinstall that has always worked still does.
lock_moved() {
    command -v git >/dev/null 2>&1 || return 1
    [ -d "$PROJECT/.git" ] || return 1

    local branch
    branch="$(git -C "$PROJECT" rev-parse --abbrev-ref HEAD 2>/dev/null)"
    [ -n "$branch" ] && [ "$branch" != "HEAD" ] || return 1
    # Local changes are self_update's to set aside, not a reason to never look: this line
    # used to answer "no" for a dirty checkout, silently, on every start.
    git -C "$PROJECT" config core.fileMode false 2>/dev/null

    local fetch=(git -C "$PROJECT" fetch --quiet --depth 1 origin "$branch")
    command -v timeout >/dev/null 2>&1 && fetch=(timeout 20 "${fetch[@]}")
    GIT_TERMINAL_PROMPT=0 "${fetch[@]}" 2>/dev/null || return 1

    if [ "$(git -C "$PROJECT" rev-parse --is-shallow-repository)" != "true" ] \
            && ! git -C "$PROJECT" merge-base --is-ancestor HEAD "origin/$branch" 2>/dev/null; then
        return 1
    fi

    # web/shell-build too: it is what this server reports as sv_web_build, so a new shell
    # pinned on the branch without a lock bump used to reach no box until a reinstall,
    # and its players stayed on the previous shell.
    git -C "$PROJECT" diff --quiet HEAD "origin/$branch" -- addons.lock web/shell-build 2>/dev/null \
        && return 1

    # [b]Not onto a lock whose shell is not pinned yet.[/b] A lock is pushed first and the
    # web-shell workflow exports, uploads and pins its shell some minutes later. A box
    # that moved in between would serve the new addons to players framed in the old
    # shell, and a game built on the new addons would be refused at Play. The record's
    # `lock` line is sha256 of the lock the pinned shell was exported from
    # (tools/shell-inputs.sh). A branch with no record predates this and is followed.
    local record lock_sum
    command -v sha256sum >/dev/null 2>&1 || return 0
    record="$(git -C "$PROJECT" show "origin/$branch:web/shell-build.inputs" 2>/dev/null)" || return 0
    lock_sum="$(git -C "$PROJECT" show "origin/$branch:addons.lock" 2>/dev/null | sha256sum | cut -d' ' -f1)"
    if ! printf '%s\n' "$record" | grep -qxF "lock	$lock_sum"; then
        # WARN, not a note: if the web-shell workflow is failing, this line on every
        # start is how an operator finds out that no box is taking the new lock.
        warn "the addon lock on this checkout's branch has moved, but its web shell is not pinned yet (dot-server-deploy's web-shell workflow); staying on this one until it is"
        return 1
    fi
    return 0
}

case "$AUTO_UPDATE" in
    when-needed|always|never) ;;
    *) die "--auto-update / TMC_AUTO_UPDATE is when-needed, always or never, not '$AUTO_UPDATE'" ;;
esac

if [ "$AUTO_UPDATE" = "always" ] && [ -z "${TMC_AUTO_UPDATED:-}" ] \
        && { [ "$COMMAND" = "run" ] || [ "$COMMAND" = "check" ]; }; then
    printf '\n  %supdate%s\n' "$BLD" "$OFF"
    update_and_restart || warn "starting on the addons this box already has"
fi

if [ "$AUTO_UPDATE" = "when-needed" ] && [ -z "${TMC_AUTO_UPDATED:-}" ] \
        && { [ "$COMMAND" = "run" ] || [ "$COMMAND" = "check" ]; } && lock_moved; then
    printf '\n  %supdate%s\n' "$BLD" "$OFF"
    note "the addon lock on this checkout's branch has moved; updating so players are offered the new addons"
    update_and_restart || warn "starting on the addons this box already has"
fi

# cfg/content.yml (a server's settings per game, maps included) is newer than most boxes'
# cfg/, and setup.sh (which copies a missing template) runs only on an install or an
# update. Without it a game whose maps moved out of its game.yml and into this file would
# come up with only the maps in its pack. So the one file is copied here when it is
# missing -- never over one that exists, like setup.
if [ ! -f "$CONFIG_DIR/content.yml" ] && [ -f "$PROJECT/cfg.example/content.yml" ] \
        && [ -d "$CONFIG_DIR" ] && { [ "$COMMAND" = "run" ] || [ "$COMMAND" = "check" ]; }; then
    cat "$PROJECT/cfg.example/content.yml" > "$CONFIG_DIR/content.yml" \
        && note "wrote $CONFIG_DIR/content.yml from the template: this server's settings per game"
fi

# cfg/maps.yml and cfg/games.yml (which maps and which games PLAY; the rest stay installed)
# are newer than that, and copied the same way. The templates only comment out their examples,
# so a copy changes nothing until an operator edits it.
for rotation_file in maps.yml games.yml; do
    if [ ! -f "$CONFIG_DIR/$rotation_file" ] && [ -f "$PROJECT/cfg.example/$rotation_file" ] \
            && [ -d "$CONFIG_DIR" ] && { [ "$COMMAND" = "run" ] || [ "$COMMAND" = "check" ]; }; then
        cat "$PROJECT/cfg.example/$rotation_file" > "$CONFIG_DIR/$rotation_file" \
            && note "wrote $CONFIG_DIR/$rotation_file from the template: which ${rotation_file%.yml} play"
    fi
done

# cfg/addons.yml (the extra packs an owner adds per game) is newer still, and copied the
# same way: when it is missing, never over one that exists.
if [ ! -f "$CONFIG_DIR/addons.yml" ] && [ -f "$PROJECT/cfg.example/addons.yml" ] \
        && [ -d "$CONFIG_DIR" ] && { [ "$COMMAND" = "run" ] || [ "$COMMAND" = "check" ]; }; then
    cat "$PROJECT/cfg.example/addons.yml" > "$CONFIG_DIR/addons.yml" \
        && note "wrote $CONFIG_DIR/addons.yml from the template: extra packs this server adds per game"
fi

if [ -z "$NO_INSTALL" ] && { [ -n "$OPT_GAMES" ] || has_owner_maps || has_owner_addons; } \
        && { [ "$COMMAND" = "run" ] || [ "$COMMAND" = "check" ]; }; then
    printf '\n  %sgames%s\n' "$BLD" "$OFF"
    do_install_games
    install_status=$?

    case "$install_status" in
        0) ;;
        3) warn "some games could not be installed; starting with the rest" ;;
        4)
            if [ "$AUTO_UPDATE" != "never" ] && [ -z "${TMC_AUTO_UPDATED:-}" ]; then
                note "a game needs newer addons than this server has; updating them"
                update_and_restart
            fi
            if [ -n "${TMC_AUTO_UPDATED:-}" ]; then
                warn "even the newest addons this checkout locks are too old for a game above;"
                warn "it stays on the version that runs until a server release catches up"
            else
                warn "a game needs newer addons than this server has, and the update above did"
                warn "not happen (its reason is printed above); it stays on the version that runs"
            fi
            ;;
        *) warn "no games could be installed from the content origin" ;;
    esac
fi

[ -n "$VERBOSE" ] && ARGS+=("$VERBOSE")
[ ${#OVERRIDES[@]} -gt 0 ] && ARGS+=("${OVERRIDES[@]}")
[ ${#PASSTHROUGH[@]} -gt 0 ] && ARGS+=("${PASSTHROUGH[@]}")

if [ -n "${DRY_RUN:-}" ]; then
    printf '%q ' "$GODOT" "${ARGS[@]}"; printf '\n'
    exit 0
fi

# exec, not a subshell: one process, so ctrl-c and SIGTERM reach the server rather than
# a wrapper that has to forward them — and so a container's PID 1 is the server.
exec "$GODOT" "${ARGS[@]}"
